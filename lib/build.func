#!/usr/bin/env bash

variables() {
  NSAPP=$(echo ${APP,,} | tr -d ' ') # This function sets the NSAPP variable by converting the value of the APP variable to lowercase and removing any spaces.
  var_install="${NSAPP}-install"     # sets the var_install variable by appending "-install" to the value of NSAPP.
  INTEGER='^[0-9]+([.][0-9]+)?$'     # it defines the INTEGER regular expression pattern.
  SPINNER_PID=""                     # read by msg_* and error_handler, which can run before start()
  BACKTITLE="Salvialf PVE scripts - ${APP} LXC" # shown on every whiptail window
}

# This function sets various color variables using ANSI escape codes for formatting text in the terminal.
color() {
  YW=$(echo "\033[33m")
  BL=$(echo "\033[36m")
  RD=$(echo "\033[01;31m")
  BGN=$(echo "\033[4;92m")
  GN=$(echo "\033[1;92m")
  DGN=$(echo "\033[32m")
  CL=$(echo "\033[m")
  CM="${GN}✓${CL}"
  CROSS="${RD}✗${CL}"
  BFR="\\r\\033[K"
  HOLD=" "
}

# This function enables error handling in the script by setting options and defining a trap for the ERR signal.
catch_errors() {
  set -Eeuo pipefail
  trap 'error_handler $LINENO "$BASH_COMMAND"' ERR
}

# This function is called when an error occurs. It receives the exit code, line number, and command that caused the error, and displays an error message.
error_handler() {
  local exit_code="$?"
  if [ -n "$SPINNER_PID" ] && ps -p $SPINNER_PID > /dev/null; then kill $SPINNER_PID > /dev/null; fi
  printf "\e[?25h"
  local line_number="$1"
  local command="$2"
  local error_message="${RD}[ERROR]${CL} in line ${RD}$line_number${CL}: exit code ${RD}$exit_code${CL}: while executing command ${YW}$command${CL}"
  echo -e "\n$error_message\n"
}

# This function displays a spinner.
spinner() {
    local chars="/-\|"
    local spin_i=0
    printf "\e[?25l"
    while true; do
        printf "\r \e[36m%s\e[0m" "${chars:spin_i++%${#chars}:1}"
        sleep 0.1
    done
}

# This function displays an informational message with a yellow color.
msg_info() {
  local msg="$1"
  echo -ne " ${HOLD} ${YW}${msg}   "
  spinner &
  SPINNER_PID=$!
}

# This function displays a success message with a green color.
msg_ok() {
  if [ -n "$SPINNER_PID" ] && ps -p $SPINNER_PID > /dev/null; then kill $SPINNER_PID > /dev/null; fi
  SPINNER_PID=""
  printf "\e[?25h"
  local msg="$1"
  echo -e "${BFR} ${CM} ${GN}${msg}${CL}"
}

# This function displays a error message with a red color.
msg_error() {
  if [ -n "$SPINNER_PID" ] && ps -p $SPINNER_PID > /dev/null; then kill $SPINNER_PID > /dev/null; fi
  SPINNER_PID=""
  printf "\e[?25h"
  local msg="$1"
  echo -e "${BFR} ${CROSS} ${RD}${msg}${CL}"
}

# This function displays a warning message with a yellow color.
msg_warn() {
  local msg="$1"
  echo -e "${BFR} ${YW}⚠ ${msg}${CL}"
}

# Check if the shell is using bash
shell_check() {
  if [[ "$(basename "$SHELL")" != "bash" ]]; then
    clear
    msg_error "Your default shell is currently not set to Bash. To use these scripts, please switch to the Bash shell."
    echo -e "\nExiting..."
    sleep 2
    exit
  fi
}

# Run as root only
root_check() {
  if [[ "$(id -u)" -ne 0 || $(ps -o comm= -p $PPID) == "sudo" ]]; then
    clear
    msg_error "Please run this script as root."
    echo -e "\nExiting..."
    sleep 2
    exit
  fi
}

# This function checks the version of Proxmox Virtual Environment (PVE) and exits if the version is not supported.
pve_check() {
  if ! pveversion | grep -Eq "pve-manager/(8\.[1-9]|9\.[0-9])"; then
    msg_error "This version of Proxmox Virtual Environment is not supported"
    echo -e "Requires Proxmox Virtual Environment Version 8.1 or later."
    echo -e "Exiting..."
    sleep 2
    exit
fi
}

# This function checks the system architecture and exits if it's not "amd64".
arch_check() {
  if [ "$(dpkg --print-architecture)" != "amd64" ]; then
    echo -e "\n ${CROSS} This script will not work with PiMox! \n"
    echo -e "\n Visit https://github.com/asylumexp/Proxmox for ARM64 support. \n"
    echo -e "Exiting..."
    sleep 2
    exit
  fi
}

# This function checks if the script is running through a genuinely external SSH session and warns (without blocking), since on PVE 9.x the Proxmox WebUI Shell also sets SSH_CLIENT, with a local client IP.
ssh_check() {
  if command -v pveversion >/dev/null 2>&1 && [ -n "${SSH_CLIENT:+x}" ]; then
    local client_ip host_ip host_subnet client_subnet
    client_ip=$(awk '{print $1}' <<<"$SSH_CLIENT")
    host_ip=$(hostname -I | awk '{print $1}')

    # Local connection (Proxmox WebUI Shell or same machine): not a real remote SSH session
    if [[ "$client_ip" == "127.0.0.1" || "$client_ip" == "::1" || "$client_ip" == "$host_ip" ]]; then
      return
    fi

    # Same local subnet
    host_subnet=$(echo "$host_ip" | cut -d. -f1-3)
    client_subnet=$(echo "$client_ip" | cut -d. -f1-3)
    if [[ "$host_subnet" == "$client_subnet" ]]; then
      return
    fi

    msg_warn "Running via external SSH (client: $client_ip). For better stability, use the Proxmox Shell instead."
  fi
}

# This function displays the default values for various settings.
echo_default() {
  echo -e "${DGN}Using Distribution: ${BGN}$var_os${CL}"
  echo -e "${DGN}Using $var_os Version: ${BGN}$var_version${CL}"
  echo -e "${DGN}Using Container Type: ${BGN}$CT_TYPE${CL}"
  echo -e "${DGN}Using Root Password: ${BGN}Automatic Login${CL}"
  echo -e "${DGN}Using Container ID: ${BGN}$NEXTID${CL}"
  echo -e "${DGN}Using Hostname: ${BGN}$NSAPP${CL}"
  echo -e "${DGN}Using Disk Size: ${BGN}$var_disk GiB${CL}"
  echo -e "${DGN}Using CPU Cores: ${BGN}$var_cpu${CL}"
  echo -e "${DGN}Using RAM Size: ${BGN}$var_ram MiB${CL}"
  echo -e "${DGN}Using Bridge: ${BGN}vmbr0${CL}"
  echo -e "${DGN}Using Static IP Address: ${BGN}dhcp${CL}"
  echo -e "${DGN}Using Gateway IP Address: ${BGN}Default${CL}"
  echo -e "${DGN}Using Apt-Cacher IP Address: ${BGN}Default${CL}"
  echo -e "${DGN}Disable IPv6: ${BGN}No${CL}"
  echo -e "${DGN}Using Interface MTU Size: ${BGN}Default${CL}"
  echo -e "${DGN}Using DNS Search Domain: ${BGN}Host${CL}"
  echo -e "${DGN}Using DNS Server Address: ${BGN}Host${CL}"
  echo -e "${DGN}Using MAC Address: ${BGN}Default${CL}"
  echo -e "${DGN}Using VLAN Tag: ${BGN}Default${CL}"
  echo -e "${DGN}Enable Root SSH Access: ${BGN}No${CL}"
  echo -e "${DGN}Enable Verbose Mode: ${BGN}No${CL}"
  echo -e "${BL}Creating a ${APP} LXC using the above default settings${CL}"
}

# This function is called when the user decides to exit the script. It clears the screen and displays an exit message.
exit-script() {
  clear
  echo -e "⚠  User exited script \n"
  exit
}

# This function wraps whiptail: centered backtitle, sizes added after the box text, the answer is returned on stdout.
# The box option must be directly followed by its text.
wt() {
  local args=() cols breaks msgbox="" rc=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --inputbox | --yesno)
        args+=("$1" "$2" 0 58); shift 2 ;;
      --msgbox)
        msgbox="yes"
        args+=("$1" "$2" 0 58); shift 2 ;;
      --passwordbox)
        # newt's auto-size has no case for passwordbox and hides the text: 8 rows for one line, plus one per \n
        breaks="${2//\\n/}"
        args+=("$1" "$2" $(((${#2} - ${#breaks}) / 2 + 8)) 58); shift 2 ;;
      --menu | --radiolist | --checklist)
        args+=("$1" "$2" 0 58 0); shift 2 ;;
      *)
        args+=("$1"); shift ;;
    esac
  done
  # stdout is captured by the caller, ask the terminal directly
  read -r _ cols < <(stty size </dev/tty)
  whiptail --backtitle "$(printf '%*s' $(((cols - ${#BACKTITLE}) / 2)) '')$BACKTITLE" "${args[@]}" 3>&1 1>&2 2>&3 || rc=$?
  # A msgbox has nothing to answer: ESC closes it like OK instead of failing under set -e
  [ -n "$msgbox" ] && rc=0
  return "$rc"
}

# This function prints the radiolist status of an item: ON when it matches the value to preselect.
wt_status() {
  [ "$1" == "$2" ] && echo ON || echo OFF
}

# This function allows the user to configure advanced settings for the script.
advanced_settings() {
  if [ "$var_os" != "alpine" ] && [ "${var_os_locked:-no}" != "yes" ]; then
    var_os=$(wt --title "DISTRIBUTION" --radiolist "Choose the distribution" \
      "debian" "" "$(wt_status debian "$var_os")" \
      "ubuntu" "" "$(wt_status ubuntu "$var_os")") || exit-script
  fi
  echo -e "${DGN}Using Distribution: ${BGN}$var_os${CL}"

  if [ "$var_os" == "debian" ]; then
    var_version=$(wt --title "DEBIAN VERSION" --radiolist "Choose the Debian version" \
      "12" "Bookworm" "$(wt_status 12 "$var_version")" \
      "13" "Trixie" "$(wt_status 13 "$var_version")") || exit-script
  elif [ "$var_os" == "ubuntu" ]; then
    var_version=$(wt --title "UBUNTU VERSION" --radiolist "Choose the Ubuntu version" \
      "20.04" "Focal" "$(wt_status 20.04 "$var_version")" \
      "22.04" "Jammy" "$(wt_status 22.04 "$var_version")" \
      "24.04" "Noble" "$(wt_status 24.04 "$var_version")") || exit-script
  fi
  echo -e "${DGN}Using $var_os Version: ${BGN}$var_version${CL}"

  CT_TYPE=$(wt --title "CONTAINER TYPE" --radiolist "Choose the container type" \
    "1" "Unprivileged" "$(wt_status 1 "${CT_TYPE:-1}")" \
    "0" "Privileged" "$(wt_status 0 "${CT_TYPE:-1}")") || exit-script
  echo -e "${DGN}Using Container Type: ${BGN}$CT_TYPE${CL}"

  while true; do
    PW1=$(wt --passwordbox "Set the root password, required for root SSH access\nLeave blank for automatic console login" --title "ROOT PASSWORD") || exit-script
    if [ -z "$PW1" ]; then
      PW=""
      echo -e "${DGN}Using Root Password: ${BGN}Automatic Login${CL}"
      break
    fi
    if [[ "$PW1" == *" "* ]]; then
      wt --title "ROOT PASSWORD" --msgbox "Password cannot contain spaces. Please try again."
      continue
    fi
    if [ ${#PW1} -lt 5 ]; then
      wt --title "ROOT PASSWORD" --msgbox "Password must be at least 5 characters long. Please try again."
      continue
    fi
    PW2=$(wt --passwordbox "Confirm the root password" --title "ROOT PASSWORD") || exit-script
    if [[ "$PW1" == "$PW2" ]]; then
      PW="-password $PW1"
      echo -e "${DGN}Using Root Password: ${BGN}********${CL}"
      break
    fi
    wt --title "ROOT PASSWORD" --msgbox "Passwords do not match. Please try again."
  done

  CT_ID=$(wt --inputbox "Set the container ID" "$NEXTID" --title "CONTAINER ID") || exit-script
  CT_ID="${CT_ID:-$NEXTID}"
  echo -e "${DGN}Using Container ID: ${BGN}$CT_ID${CL}"

  CT_NAME=$(wt --inputbox "Set the hostname" "$NSAPP" --title "HOSTNAME") || exit-script
  HN=$(echo ${CT_NAME,,} | tr -d ' ')
  HN="${HN:-$NSAPP}"
  echo -e "${DGN}Using Hostname: ${BGN}$HN${CL}"

  DISK_SIZE=$(wt --inputbox "Set the disk size in GiB" "$var_disk" --title "DISK SIZE") || exit-script
  DISK_SIZE="${DISK_SIZE:-$var_disk}"
  if ! [[ $DISK_SIZE =~ $INTEGER ]]; then
    echo -e "${RD}⚠ DISK SIZE MUST BE AN INTEGER NUMBER!${CL}"
    advanced_settings
  fi
  echo -e "${DGN}Using Disk Size: ${BGN}$DISK_SIZE GiB${CL}"

  CORE_COUNT=$(wt --inputbox "Set the number of CPU cores" "$var_cpu" --title "CPU CORES") || exit-script
  CORE_COUNT="${CORE_COUNT:-$var_cpu}"
  echo -e "${DGN}Using CPU Cores: ${BGN}$CORE_COUNT${CL}"

  RAM_SIZE=$(wt --inputbox "Set the RAM size in MiB" "$var_ram" --title "RAM") || exit-script
  RAM_SIZE="${RAM_SIZE:-$var_ram}"
  echo -e "${DGN}Using RAM Size: ${BGN}$RAM_SIZE MiB${CL}"

  BRG=$(wt --inputbox "Set the network bridge" vmbr0 --title "BRIDGE") || exit-script
  BRG="${BRG:-vmbr0}"
  echo -e "${DGN}Using Bridge: ${BGN}$BRG${CL}"

  while true; do
    NET=$(wt --inputbox "Set a static IPv4 address, e.g. 192.168.1.50/24\nKeep dhcp for automatic addressing" dhcp --title "IPv4 ADDRESS") || exit-script
    [[ "$NET" == "dhcp" || "$NET" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}/([0-9]|[1-2][0-9]|3[0-2])$ ]] && break
    wt --title "IPv4 ADDRESS" --msgbox "Invalid IPv4 address: $NET\nUse the format 192.168.1.50/24, or dhcp"
  done
  echo -e "${DGN}Using IP Address: ${BGN}$NET${CL}"

  if [ "$NET" != "dhcp" ]; then
    while true; do
      GATE1=$(wt --inputbox "Set the gateway IPv4 address, e.g. 192.168.1.1" --title "GATEWAY") || exit-script
      [[ "$GATE1" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] && break
      wt --title "GATEWAY" --msgbox "Invalid gateway address: $GATE1\nUse the format 192.168.1.1"
    done
    GATE=",gw=$GATE1"
  else
    GATE=""
    GATE1="Default"
  fi
  echo -e "${DGN}Using Gateway IP Address: ${BGN}$GATE1${CL}"

  if [ "$var_os" == "alpine" ]; then
    APT_CACHER=""
    APT_CACHER_IP=""
  else
    APT_CACHER_IP=$(wt --inputbox "Set the APT-Cacher IP address\nLeave blank to not use one" --title "APT-CACHER") || exit-script
    APT_CACHER="${APT_CACHER_IP:+yes}"
  fi
  echo -e "${DGN}Using APT-Cacher IP Address: ${BGN}${APT_CACHER_IP:-Default}${CL}"

  if wt --defaultno --title "IPv6" --yesno "Disable IPv6?"; then
    DISABLEIP6="yes"
  else
    DISABLEIP6="no"
  fi
  echo -e "${DGN}Disable IPv6: ${BGN}$DISABLEIP6${CL}"

  MTU1=$(wt --inputbox "Set the interface MTU size\nLeave blank for default" --title "MTU") || exit-script
  if [ -z $MTU1 ]; then
    MTU1="Default"
    MTU=""
  else
    MTU=",mtu=$MTU1"
  fi
  echo -e "${DGN}Using Interface MTU Size: ${BGN}$MTU1${CL}"

  SD=$(wt --inputbox "Set the DNS search domain\nLeave blank to use the host's" --title "DNS SEARCH DOMAIN") || exit-script
  if [ -z $SD ]; then
    SX=Host
    SD=""
  else
    SX=$SD
    SD="-searchdomain=$SD"
  fi
  echo -e "${DGN}Using DNS Search Domain: ${BGN}$SX${CL}"

  NX=$(wt --inputbox "Set the DNS server IP address\nLeave blank to use the host's" --title "DNS SERVER") || exit-script
  if [ -z $NX ]; then
    NX=Host
    NS=""
  else
    NS="-nameserver=$NX"
  fi
  echo -e "${DGN}Using DNS Server IP Address: ${BGN}$NX${CL}"

  MAC1=$(wt --inputbox "Set the MAC address\nLeave blank for a generated one" --title "MAC ADDRESS") || exit-script
  if [ -z $MAC1 ]; then
    MAC1="Default"
    MAC=""
  else
    MAC=",hwaddr=$MAC1"
  fi
  echo -e "${DGN}Using MAC Address: ${BGN}$MAC1${CL}"

  VLAN1=$(wt --inputbox "Set the VLAN tag\nLeave blank for none" --title "VLAN") || exit-script
  if [ -z $VLAN1 ]; then
    VLAN1="Default"
    VLAN=""
  else
    VLAN=",tag=$VLAN1"
  fi
  echo -e "${DGN}Using Vlan: ${BGN}$VLAN1${CL}"

  if [[ "$PW" == -password* ]]; then
    if wt --defaultno --title "ROOT SSH ACCESS" --yesno "Enable root SSH access?"; then
      SSH="yes"
    else
      SSH="no"
    fi
  else
    SSH="no"
  fi
  echo -e "${DGN}Enable Root SSH Access: ${BGN}$SSH${CL}"

  if wt --defaultno --title "VERBOSE MODE" --yesno "Enable verbose mode?"; then
    VERB="yes"
  else
    VERB="no"
  fi
  echo -e "${DGN}Enable Verbose Mode: ${BGN}$VERB${CL}"

  # App-specific questions, optionally defined by ct/<app>.sh
  if declare -F app_settings >/dev/null; then
    app_settings
  fi

  if wt --title "CONFIRMATION" --yesno "Ready to create the ${APP} LXC?"; then
    echo -e "${RD}Creating a ${APP} LXC using the above advanced settings${CL}"
  else
    clear
    header_info
    echo -e "${RD}Using Advanced Settings${CL}"
    advanced_settings
  fi
}

install_script() {
  pve_check
  shell_check
  root_check
  arch_check
  ssh_check

  # Pauses/resumes tteck's optional monitor-all.sh host ping service
  # if systemctl is-active -q ping-instances.service; then
  #   systemctl -q stop ping-instances.service
  # fi
  NEXTID=$(pvesh get /cluster/nextid)
  # timedatectl is more reliable than /etc/timezone on newer systemd-based
  # hosts (e.g. Debian 13); fall back to /etc/timezone for older systems.
  if command -v timedatectl >/dev/null 2>&1; then
    timezone=$(timedatectl show --value --property=Timezone 2>/dev/null || echo "UTC")
  elif [ -f /etc/timezone ]; then
    timezone=$(cat /etc/timezone)
  else
    timezone="UTC"
  fi
  header_info
  if wt --title "SETTINGS" --yesno "Use default settings?" --no-button Advanced; then
    header_info
    echo -e "${BL}Using Default Settings${CL}"
    default_settings
  else
    header_info
    echo -e "${RD}Using Advanced Settings${CL}"
    advanced_settings
  fi
}

start() {
  if command -v pveversion >/dev/null 2>&1; then
    wt --title "CREATE CONTAINER" --yesno "This will create a new ${APP} LXC. Proceed?" || exit-script
    install_script
  else
    wt --title "UPDATE CONTAINER" --yesno "This will update the ${APP} LXC. Proceed?" || exit-script
    update_script
  fi
}

# This function collects user settings and integrates all the collected information.
build_container() {
#  if [ "$VERB" == "yes" ]; then set -x; fi

  if [ "$CT_TYPE" == "1" ]; then
    FEATURES="keyctl=1,nesting=1"
  else
    FEATURES="nesting=1"
  fi


  TEMP_DIR=$(mktemp -d)
  pushd $TEMP_DIR >/dev/null
  if [ "$var_os" == "alpine" ]; then
    export FUNCTIONS_FILE_PATH="$(curl -s https://raw.githubusercontent.com/tteck/Proxmox/main/misc/alpine-install.func)"
  else
    export FUNCTIONS_FILE_PATH="$(curl -s https://raw.githubusercontent.com/Salvialf/pve-scripts/main/lib/install.func)"
  fi
  export CACHER="$APT_CACHER"
  export CACHER_IP="$APT_CACHER_IP"
  export tz="$timezone"
  export DISABLEIPV6="$DISABLEIP6"
  export APPLICATION="$APP"
  export app="$NSAPP"
  export PASSWORD="$PW"
  export VERBOSE="$VERB"
  export SSH_ROOT="${SSH}"
  export CTID="$CT_ID"
  export CTTYPE="$CT_TYPE"
  export PCT_OSTYPE="$var_os"
  export PCT_OSVERSION="$var_version"
  export PCT_DISK_SIZE="$DISK_SIZE"
  export PCT_OPTIONS="
    -features $FEATURES
    -hostname $HN
    -tags salvialf-pve-scripts
    $SD
    $NS
    -net0 name=eth0,bridge=$BRG$MAC,ip=$NET$GATE$VLAN$MTU
    -onboot 1
    -cores $CORE_COUNT
    -memory $RAM_SIZE
    -unprivileged $CT_TYPE
    $PW
  "
  # This executes create_lxc.sh and creates the container and .conf file
  bash -c "$(wget -qLO - https://raw.githubusercontent.com/Salvialf/pve-scripts/main/lib/create_lxc.sh)" || exit

  LXC_CONFIG=/etc/pve/lxc/${CTID}.conf
  if [ "$CT_TYPE" == "0" ]; then
    cat <<EOF >>$LXC_CONFIG
# USB passthrough
lxc.cgroup2.devices.allow: a
lxc.cap.drop:
lxc.cgroup2.devices.allow: c 188:* rwm
lxc.cgroup2.devices.allow: c 189:* rwm
lxc.mount.entry: /dev/serial/by-id  dev/serial/by-id  none bind,optional,create=dir
lxc.mount.entry: /dev/ttyUSB0       dev/ttyUSB0       none bind,optional,create=file
lxc.mount.entry: /dev/ttyUSB1       dev/ttyUSB1       none bind,optional,create=file
lxc.mount.entry: /dev/ttyACM0       dev/ttyACM0       none bind,optional,create=file
lxc.mount.entry: /dev/ttyACM1       dev/ttyACM1       none bind,optional,create=file
EOF
  fi

  if [ "$CT_TYPE" == "0" ]; then
    if [[ "$APP" == "Channels" || "$APP" == "Emby" || "$APP" == "ErsatzTV" || "$APP" == "Frigate" || "$APP" == "Jellyfin" || "$APP" == "Plex" || "$APP" == "Scrypted" || "$APP" == "Tdarr" || "$APP" == "Unmanic" || "$APP" == "Ollama" ]]; then
      cat <<EOF >>$LXC_CONFIG
# VAAPI hardware transcoding
lxc.cgroup2.devices.allow: c 226:0 rwm
lxc.cgroup2.devices.allow: c 226:128 rwm
lxc.cgroup2.devices.allow: c 29:0 rwm
lxc.mount.entry: /dev/fb0 dev/fb0 none bind,optional,create=file
lxc.mount.entry: /dev/dri dev/dri none bind,optional,create=dir
lxc.mount.entry: /dev/dri/renderD128 dev/dri/renderD128 none bind,optional,create=file
EOF
    fi
  else
    if [[ "$APP" == "Channels" || "$APP" == "Emby" || "$APP" == "ErsatzTV" || "$APP" == "Frigate" || "$APP" == "Jellyfin" || "$APP" == "Plex" || "$APP" == "Scrypted" || "$APP" == "Tdarr" || "$APP" == "Unmanic" || "$APP" == "Ollama" ]]; then
      if [[ -e "/dev/dri/renderD128" ]]; then
        if [[ -e "/dev/dri/card0" ]]; then
          cat <<EOF >>$LXC_CONFIG
# VAAPI hardware transcoding
dev0: /dev/dri/card0,gid=44
dev1: /dev/dri/renderD128,gid=104
EOF
        else
          cat <<EOF >>$LXC_CONFIG
# VAAPI hardware transcoding
dev0: /dev/dri/card1,gid=44
dev1: /dev/dri/renderD128,gid=104
EOF
        fi
      fi
    fi
  fi

  # This starts the container and executes <app>-install.sh
  msg_info "Starting LXC Container"
  pct start "$CTID"
  msg_ok "Started LXC Container"
  # Fix Debian 13 LXC template bug where / is owned by nobody:nogroup
  # (must be done from the host, an unprivileged container cannot chown /)
  ROOTFS_MP="/var/lib/lxc/$CTID/rootfs"
  if [ -d "$ROOTFS_MP" ] && [ "$(stat -c '%U' "$ROOTFS_MP")" != "root" ]; then
    chown root:root "$ROOTFS_MP" 2>/dev/null || true
  fi
  if [ "$var_os" == "alpine" ]; then
    sleep 3
        pct exec "$CTID" -- /bin/sh -c 'cat <<EOF >/etc/apk/repositories
http://dl-cdn.alpinelinux.org/alpine/latest-stable/main
http://dl-cdn.alpinelinux.org/alpine/latest-stable/community
#http://dl-cdn.alpinelinux.org/alpine/v3.19/main
#http://dl-cdn.alpinelinux.org/alpine/v3.19/community
EOF'
    pct exec "$CTID" -- ash -c "apk add bash >/dev/null"
  fi
  lxc-attach -n "$CTID" -- bash -c "$(wget -qLO - https://raw.githubusercontent.com/Salvialf/pve-scripts/main/install/$var_install.sh)" || exit

}

# This function prints the container's IPv4 address on eth0.
get_ip() {
  pct exec "$CTID" ip a s dev eth0 | awk '/inet / {print $2}' | cut -d/ -f1
}

