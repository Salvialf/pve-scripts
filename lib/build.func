# Disk, CPU, RAM and OS come from the ct script's var_* variables, else the distribution's defaults
default_settings() {
  # The first supported distribution, in its latest version unless the app needs another
  var_os="${var_os_supported%% *}"
  var_os_version="${var_os_version:-$(os_default_version "$var_os")}"
  # Default to the storages the Proxmox VE installer creates
  DEFAULT_TEMPLATE_STORAGE=$(preferred_storage "$TEMPLATE_STORAGE_LIST" local local-btrfs)
  TEMPLATE_STORAGE="$DEFAULT_TEMPLATE_STORAGE"
  CONTAINER_STORAGE=$(preferred_storage "$CONTAINER_STORAGE_LIST" local-lvm local-zfs local-btrfs)
  CONTAINER_STORAGE_FREE=$(storage_free "$CONTAINER_STORAGE")
  DEFAULT_BRIDGE="${BRIDGE_NAMES[0]}"
  if [[ " ${BRIDGE_NAMES[*]} " == *" vmbr0 "* ]]; then
    DEFAULT_BRIDGE="vmbr0"
  fi
  BRIDGE="$DEFAULT_BRIDGE"
  UNPRIVILEGED="1"
  ROOT_PASSWORD=""
  CT_ID=$NEXTID
  CT_HOSTNAME=$APP_SLUG
  default_resources
  IPV4="dhcp"
  GATEWAY=""
  APT_CACHER=""
  DISABLE_IPV6="no"
  MTU=""
  SEARCH_DOMAIN=""
  DNS_SERVER=""
  MAC=""
  VLAN=""
  ROOT_SSH="no"
  ONBOOT="${var_onboot:-no}"
  DOCKER_SUPPORT="${var_docker_support:-no}"
  GPU_DEVICE=""
  TUN="${var_tun:-no}"
  USB_DEVICES=""
  VERBOSE="no"
  # The ct script's app_settings values, if any
  if declare -F app_default_settings >/dev/null; then
    app_default_settings
  fi
}

# The ct script's var_disk_<family>, else its var_disk, else the family's default (same for CPU and RAM)
default_resources() {
  local family="debian" disk="2" ram="512" name
  if [ "$var_os" == "alpine" ]; then
    family="alpine" disk="0.5" ram="256"
  fi
  name="var_disk_$family"
  DEFAULT_DISK_SIZE="${!name:-${var_disk:-$disk}}"
  name="var_cpu_$family"
  DEFAULT_CORE_COUNT="${!name:-${var_cpu:-1}}"
  name="var_ram_$family"
  DEFAULT_RAM_SIZE="${!name:-${var_ram:-$ram}}"
  DISK_SIZE="$DEFAULT_DISK_SIZE"
  CORE_COUNT="$DEFAULT_CORE_COUNT"
  RAM_SIZE="$DEFAULT_RAM_SIZE"
}

# Prints the arguments separated by commas, nothing without arguments
join_list() {
  local list
  list=$(printf '%s, ' "$@")
  echo "${list%, }"
}

# Succeeds when $3 is a whole number between $1 and $2 (9 digits at most, so test can compare it)
is_number_in() {
  [[ "$3" =~ ^[0-9]{1,9}$ ]] && [ "$3" -ge "$1" ] && [ "$3" -le "$2" ]
}

is_ipv4() {
  local octet='(25[0-5]|2[0-4][0-9]|1?[0-9]?[0-9])'
  [[ "$1" =~ ^($octet\.){3}$octet$ ]]
}

# Dot-separated labels of letters, digits and inner hyphens, 63 characters per label (DNS), 255 in all (Proxmox)
is_dns_name() {
  local label='[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?'
  [ ${#1} -le 255 ] && [[ "$1" =~ ^($label\.)*$label$ ]]
}

# pvesm sizes are in KiB
kib_to_gib() {
  awk -v kib="$1" 'BEGIN {printf "%.2f", kib / 1048576}'
}

# Free space of a container storage, in KiB
storage_free() {
  awk -v storage="$1" '$1 == storage {print $6}' <<< "$CONTAINER_STORAGE_LIST"
}

# Prints the first preferred storage found in the list, else the first one by name
# Arguments: pvesm status lines without header, preferred storage names
preferred_storage() {
  local list="$1" name
  shift
  for name in "$@"; do
    if awk -v storage="$name" '$1 == storage {found = 1} END {exit !found}' <<< "$list"; then
      echo "$name"
      return
    fi
  done
  awk 'NR == 1 {print $1}' <<< "$list"
}

# Prints the storage to use, asking only when there are several
# Arguments: pvesm status lines without header, window title, window text, storage to preselect (the first one if empty)
select_storage() {
  local menu=() name type free
  # pvesm columns: Name Type Status Total Used Available %, sizes in KiB
  while read -r name type _ _ _ free _; do
    menu+=("$name" "$(printf '%-10s %s GiB free' "$type" "$(kib_to_gib "$free")")")
  done <<< "$1"
  if [ ${#menu[@]} -eq 2 ]; then
    echo "${menu[0]}"
    return
  fi
  wt --title "$2" --default-item "$4" --menu "$3" "${menu[@]}"
}

# Reads the host's storages and bridges once, before any window: a missing one stops the script here
host_lists() {
  local entry
  # pvesm is slow to start, one call per content type. An error leaves the list empty, reported below
  TEMPLATE_STORAGE_LIST=$(pvesm status -content vztmpl | awk 'NR>1') || true
  CONTAINER_STORAGE_LIST=$(pvesm status -content rootdir | awk 'NR>1') || true
  if [ -z "$TEMPLATE_STORAGE_LIST" ]; then
    msg_error "Unable to detect a valid template storage location"
    exit 1
  fi
  if [ -z "$CONTAINER_STORAGE_LIST" ]; then
    msg_error "Unable to detect a valid container storage location"
    exit 1
  fi
  BRIDGE_NAMES=()
  BRIDGE_TYPES=()
  # any_bridge: Linux/OVS bridges and SDN vnets
  # || true: with set -E, an error here would be read as a bridge
  while read -r entry; do
    BRIDGE_NAMES+=("$(sed -n 's/.*"iface":"\([^"]*\)".*/\1/p' <<< "$entry")")
    BRIDGE_TYPES+=("$(sed -n 's/.*"type":"\([^"]*\)".*/\1/p' <<< "$entry")")
  done < <(pvesh get "/nodes/$(hostname -s)/network" --type any_bridge --output-format json | grep -o '{[^}]*}' || true)
  if [ ${#BRIDGE_NAMES[@]} -eq 0 ]; then
    msg_error "Unable to detect a network bridge on this host"
    exit 1
  fi
}

# Succeeds when $1 GiB fits in the container storage's free space
disk_fits() {
  awk -v size="$1" -v kib="$CONTAINER_STORAGE_FREE" 'BEGIN {exit !(size * 1048576 <= kib)}'
}

# Asks whether to go on with a $1 GiB disk that doesn't fit, fails if the user doesn't
disk_space_warning() {
  wt --defaultno --title "DISK SPACE" --yesno "Disk size: $1 GiB\nFree on $CONTAINER_STORAGE: $(kib_to_gib "$CONTAINER_STORAGE_FREE") GiB\nContinue anyway?"
}

# step_* functions: one settings window each for run_steps, returning 0 Next, 1 Back, 255 ESC or 2 when nothing is shown

step_distribution() {
  local os menu=()
  for os in $var_os_supported; do
    menu+=("$os" "${os^}")
  done
  # A single distribution: its name and label
  if [ ${#menu[@]} -eq 2 ]; then
    return 2
  fi
  os=$(wt --title "DISTRIBUTION" --notags --default-item "$var_os" --menu "Choose the distribution" "${menu[@]}") || return
  if [ "$os" != "$var_os" ]; then
    var_os="$os"
    var_os_version=$(os_default_version "$os")
    default_resources
  fi
}

# Versions of distribution $1 with a template for this host's architecture, oldest first
os_versions() {
  pveam available -section system |
    awk '{print $2}' |
    grep "_$(dpkg --print-architecture)\.tar\." |
    sed -n "s/^$1-\([0-9.]*\)-.*/\1/p" |
    sort -uV || true
}

# Latest version of distribution $1, the latest LTS for Ubuntu: its other releases get 9 months of updates
os_default_version() {
  if [ "$1" == "ubuntu" ]; then
    os_versions ubuntu | grep -E '^[0-9]*[02468]\.04$' | tail -n 1
  else
    os_versions "$1" | tail -n 1
  fi
}

# "Debian 13 Trixie" from Proxmox's template index, else "Debian 13"
os_version_label() {
  local label
  label=$(grep -h "^Description: ${1^} $2 " /var/lib/pve-manager/apl-info/* 2>/dev/null | head -n 1 | sed 's/^Description: //; s/ (.*//') || true
  echo "${label:-${1^} $2}"
}

step_version() {
  local menu=() version
  while read -r version; do
    menu+=("$version" "$(os_version_label "$var_os" "$version")")
  done < <(os_versions "$var_os")
  if [ ${#menu[@]} -eq 0 ]; then
    return 2
  fi
  version=$(wt --title "${var_os^^} VERSION" --notags --default-item "$var_os_version" --menu "Choose the ${var_os^} version" "${menu[@]}") || return
  var_os_version="$version"
}

step_ct_id() {
  local id="${CT_ID:-$NEXTID}"
  while true; do
    id=$(wt --title "CONTAINER ID" --inputbox "Set the container ID" "$id") || return
    id="${id:-$NEXTID}"
    if ! is_number_in 100 999999999 "$id"; then
      wt --title "CONTAINER ID" --msgbox "Invalid container ID: $id\nUse a number, 100 or more"
    # Checks every VM and container of the cluster, pct status only knows containers
    elif ! pvesh get /cluster/nextid --vmid "$id" &>/dev/null; then
      wt --title "CONTAINER ID" --msgbox "Container ID $id is already in use\nby a VM or a container"
    else
      break
    fi
  done
  CT_ID="$id"
}

step_hostname() {
  local name="${CT_HOSTNAME:-$APP_SLUG}"
  while true; do
    name=$(wt --title "HOSTNAME" --inputbox "Set the hostname" "$name") || return
    # Lowercase, spaces and underscores become hyphens, leading and trailing spaces are dropped
    name=$(awk '{$1 = $1; gsub(/[ _]/, "-"); print tolower($0)}' <<< "$name")
    name="${name:-$APP_SLUG}"
    is_dns_name "$name" && break
    wt --title "HOSTNAME" --msgbox "Invalid hostname: $name\nUse unaccented letters, digits, hyphens and dots"
  done
  CT_HOSTNAME="$name"
}

step_ct_type() {
  local unprivileged
  unprivileged=$(wt --title "CONTAINER TYPE" --notags --default-item "$UNPRIVILEGED" --menu "Choose the container type" \
    "1" "Unprivileged" \
    "0" "Privileged") || return
  UNPRIVILEGED="$unprivileged"
}

settings_general() {
  run_steps step_distribution step_version step_ct_id step_hostname step_ct_type
}

summary_general() {
  echo "${var_os^} $var_os_version, CT $CT_ID, $CT_HOSTNAME, $([ "$UNPRIVILEGED" == "1" ] && echo unprivileged || echo privileged)"
}

# Asks a password then its confirmation and prints it, $3 being the current one
# $4 checks a new password: it shows why it is refused and fails
ask_password() {
  local title="$1" text="$2" current="$3" check="$4" pw1="$3" pw2
  while true; do
    # Prefilled with the current password, so going back and forth keeps it
    pw1=$(wt --title "$title" --passwordbox "$text" "$pw1") || return
    if ! "$check" "$pw1"; then
      continue
    fi
    # Blank or already confirmed
    if [ -z "$pw1" ] || [ "$pw1" == "$current" ]; then
      printf '%s' "$pw1"
      return 0
    fi
    # Back from the confirmation asks the password again
    pw2=$(wt --title "$title" --passwordbox "Confirm the password") || { [ $? -eq 1 ] && continue; return 255; }
    if [ "$pw1" == "$pw2" ]; then
      printf '%s' "$pw1"
      return 0
    fi
    wt --title "$title" --msgbox "Passwords do not match. Please try again."
  done
}

# Blank means automatic console login
root_password_check() {
  if [[ "$1" == *" "* ]]; then
    wt --title "ROOT PASSWORD" --msgbox "Password cannot contain spaces. Please try again."
    return 1
  fi
  if [ -n "$1" ] && [ ${#1} -lt 5 ]; then
    wt --title "ROOT PASSWORD" --msgbox "Password must be at least 5 characters long. Please try again."
    return 1
  fi
}

step_password() {
  local pw
  pw=$(ask_password "ROOT PASSWORD" "Set the root password, required for root SSH access\nLeave blank for automatic console login" "$ROOT_PASSWORD" root_password_check) || return
  ROOT_PASSWORD="$pw"
}

# Root SSH access needs a password
step_ssh() {
  if [ -z "$ROOT_PASSWORD" ]; then
    ROOT_SSH="no"
    return 2
  fi
  local ssh
  ssh=$(wt --title "ROOT SSH ACCESS" --notags --default-item "${ROOT_SSH:-no}" --menu "Enable root SSH access?" "yes" "Yes" "no" "No") || return
  ROOT_SSH="$ssh"
}

settings_access() {
  run_steps step_password step_ssh
}

summary_access() {
  if [ -z "$ROOT_PASSWORD" ]; then
    echo "console autologin"
  else
    echo "root password, SSH $([ "$ROOT_SSH" == "yes" ] && echo on || echo off)"
  fi
}

# Shown only when there are several
step_template_storage() {
  local storage
  storage=$(select_storage "$TEMPLATE_STORAGE_LIST" "TEMPLATE STORAGE" "Choose the storage for the container template" "${TEMPLATE_STORAGE:-}") || return
  TEMPLATE_STORAGE="$storage"
  [ "$(wc -l <<< "$TEMPLATE_STORAGE_LIST")" -gt 1 ] || return 2
}

# Shown only when there are several, keeps the storage's free space in KiB
step_container_storage() {
  local storage
  storage=$(select_storage "$CONTAINER_STORAGE_LIST" "CONTAINER STORAGE" "Choose the storage for the container disk" "${CONTAINER_STORAGE:-}") || return
  CONTAINER_STORAGE="$storage"
  CONTAINER_STORAGE_FREE=$(storage_free "$storage")
  [ "$(wc -l <<< "$CONTAINER_STORAGE_LIST")" -gt 1 ] || return 2
}

step_disk_size() {
  local size="$DISK_SIZE"
  while true; do
    size=$(wt --title "DISK SIZE" --inputbox "Set the disk size in GiB\n$(kib_to_gib "$CONTAINER_STORAGE_FREE") GiB free on $CONTAINER_STORAGE" "$size") || return
    size="${size:-$DEFAULT_DISK_SIZE}"
    if ! [[ "$size" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
      wt --title "DISK SIZE" --msgbox "Invalid disk size: $size\nUse a number of GiB, e.g. 16"
      continue
    fi
    disk_fits "$size" && break
    # No on the warning asks the size again
    disk_space_warning "$size" && break
  done
  DISK_SIZE="$size"
}

step_cpu() {
  local cores="$CORE_COUNT"
  while true; do
    cores=$(wt --title "CPU CORES" --inputbox "Set the number of CPU cores" "$cores") || return
    cores="${cores:-$DEFAULT_CORE_COUNT}"
    is_number_in 1 8192 "$cores" && break
    wt --title "CPU CORES" --msgbox "Invalid number of CPU cores: $cores\nUse a whole number from 1 to 8192"
  done
  CORE_COUNT="$cores"
}

step_ram() {
  local ram="$RAM_SIZE"
  while true; do
    ram=$(wt --title "RAM" --inputbox "Set the RAM size in MiB" "$ram") || return
    ram="${ram:-$DEFAULT_RAM_SIZE}"
    [[ "$ram" =~ ^[0-9]{1,9}$ ]] && [ "$ram" -ge 16 ] && break
    wt --title "RAM" --msgbox "Invalid RAM size: $ram\nUse a whole number of MiB, 16 or more"
  done
  RAM_SIZE="$ram"
}

settings_resources() {
  run_steps step_template_storage step_container_storage step_disk_size step_cpu step_ram
}

summary_resources() {
  local parts=("$DISK_SIZE GiB on $CONTAINER_STORAGE" "$CORE_COUNT CPU" "$RAM_SIZE MiB")
  if [ "$TEMPLATE_STORAGE" != "$DEFAULT_TEMPLATE_STORAGE" ]; then
    parts+=("template on $TEMPLATE_STORAGE")
  fi
  join_list "${parts[@]}"
}

step_bridge() {
  if [ ${#BRIDGE_NAMES[@]} -eq 1 ]; then
    BRIDGE="${BRIDGE_NAMES[0]}"
    return 2
  fi
  local menu=() bridge i
  for i in "${!BRIDGE_NAMES[@]}"; do
    menu+=("${BRIDGE_NAMES[i]}" "${BRIDGE_TYPES[i]}")
  done
  bridge=$(wt --title "BRIDGE" --default-item "${BRIDGE:-vmbr0}" --menu "Choose the network bridge" "${menu[@]}") || return
  BRIDGE="$bridge"
}

step_ipv4() {
  local ip="${IPV4:-dhcp}"
  while true; do
    ip=$(wt --title "IPv4 ADDRESS" --inputbox "Set a static IPv4 address, e.g. 192.168.1.50/24\nKeep dhcp for automatic addressing" "$ip") || return
    ip="${ip:-dhcp}"
    [ "$ip" == "dhcp" ] && break
    is_ipv4 "${ip%/*}" && [[ "$ip" =~ /([0-9]|[12][0-9]|3[0-2])$ ]] && break
    wt --title "IPv4 ADDRESS" --msgbox "Invalid IPv4 address: $ip\nUse the format 192.168.1.50/24 or dhcp"
  done
  IPV4="$ip"
}

# GATEWAY is kept with dhcp, so switching back finds it again
step_gateway() {
  if [ "$IPV4" == "dhcp" ]; then
    return 2
  fi
  local gateway="$GATEWAY"
  # The host's gateway is the right one when the container shares its network
  gateway="${gateway:-$(ip route show default | awk '{print $3; exit}')}" || true
  while true; do
    gateway=$(wt --title "GATEWAY" --inputbox "Set the gateway IPv4 address, e.g. 192.168.1.1\nPrefilled with the host's gateway" "$gateway") || return
    is_ipv4 "$gateway" && break
    wt --title "GATEWAY" --msgbox "Invalid gateway address: $gateway\nUse the format 192.168.1.1"
  done
  GATEWAY="$gateway"
}

step_ipv6() {
  local disable
  disable=$(wt --title "IPv6" --notags --default-item "${DISABLE_IPV6:-no}" --menu "Disable IPv6?" "yes" "Yes" "no" "No") || return
  DISABLE_IPV6="$disable"
}

step_vlan() {
  local vlan="$VLAN"
  while true; do
    vlan=$(wt --title "VLAN" --inputbox "Set the VLAN tag\nLeave blank for none" "$vlan") || return
    [ -z "$vlan" ] && break
    is_number_in 1 4094 "$vlan" && break
    wt --title "VLAN" --msgbox "Invalid VLAN tag: $vlan\nUse a number from 1 to 4094 or leave blank"
  done
  VLAN="$vlan"
}

step_mac() {
  local mac="$MAC"
  while true; do
    mac=$(wt --title "MAC ADDRESS" --inputbox "Set the MAC address\nLeave blank for a generated one" "$mac") || return
    [ -z "$mac" ] && break
    # Proxmox refuses multicast addresses: the second hex digit must be even
    [[ "$mac" =~ ^[a-fA-F0-9][02468aceACE](:[a-fA-F0-9]{2}){5}$ ]] && break
    wt --title "MAC ADDRESS" --msgbox "Invalid MAC address: $mac\nUse a unicast MAC, e.g. 02:00:00:00:00:01"
  done
  MAC="$mac"
}

step_mtu() {
  local mtu="$MTU"
  while true; do
    mtu=$(wt --title "MTU" --inputbox "Set the interface MTU size\nLeave blank for default" "$mtu") || return
    [ -z "$mtu" ] && break
    is_number_in 64 65535 "$mtu" && break
    wt --title "MTU" --msgbox "Invalid MTU size: $mtu\nUse a number from 64 to 65535 or leave blank"
  done
  MTU="$mtu"
}

settings_network() {
  run_steps step_bridge step_ipv4 step_gateway step_ipv6 step_vlan step_mac step_mtu
}

summary_network() {
  local parts=()
  if [ "$BRIDGE" != "$DEFAULT_BRIDGE" ]; then
    parts+=("$BRIDGE")
  fi
  if [ "$IPV4" == "dhcp" ]; then
    parts+=("dhcp")
  else
    parts+=("$IPV4 via $GATEWAY")
  fi
  parts+=("IPv6 $([ "$DISABLE_IPV6" == "yes" ] && echo off || echo on)")
  if [ -n "$VLAN" ]; then
    parts+=("VLAN $VLAN")
  fi
  if [ -n "$MAC" ]; then
    parts+=("MAC $MAC")
  fi
  if [ -n "$MTU" ]; then
    parts+=("MTU $MTU")
  fi
  join_list "${parts[@]}"
}

step_dns_server() {
  local server
  server=$(wt --title "DNS SERVER" --inputbox "Set the DNS server IP address\nLeave blank to use the host's" "$DNS_SERVER") || return
  DNS_SERVER="$server"
}

step_search_domain() {
  local domain
  domain=$(wt --title "DNS SEARCH DOMAIN" --inputbox "Set the DNS search domain\nLeave blank to use the host's" "$SEARCH_DOMAIN") || return
  SEARCH_DOMAIN="$domain"
}

settings_dns() {
  run_steps step_dns_server step_search_domain
}

summary_dns() {
  local parts=() list
  if [ -n "$DNS_SERVER" ]; then
    parts+=("$DNS_SERVER")
  fi
  if [ -n "$SEARCH_DOMAIN" ]; then
    parts+=("$SEARCH_DOMAIN")
  fi
  list=$(join_list "${parts[@]}")
  echo "${list:-same as host}"
}

step_onboot() {
  local onboot
  onboot=$(wt --title "START AT BOOT" --notags --default-item "${ONBOOT:-no}" --menu "Start the container at boot?" "yes" "Yes" "no" "No") || return
  ONBOOT="$onboot"
}

step_docker_support() {
  # keyctl only exists for unprivileged containers, privileged ones run Docker with nesting alone
  if [ "$UNPRIVILEGED" != "1" ]; then
    return 2
  fi
  local docker
  docker=$(wt --title "DOCKER SUPPORT" --notags --default-item "${DOCKER_SUPPORT:-no}" --menu "Allow running Docker inside the container?\nEnables the keyctl feature Docker needs" "yes" "Yes" "no" "No") || return
  DOCKER_SUPPORT="$docker"
}

step_apt_cacher() {
  if [ "$var_os" == "alpine" ]; then
    APT_CACHER=""
    return 2
  fi
  local cacher="$APT_CACHER"
  while true; do
    cacher=$(wt --title "APT-CACHER" --inputbox "Set the APT-Cacher IP address\nLeave blank to not use one" "$cacher") || return
    [ -z "$cacher" ] && break
    is_dns_name "$cacher" && break
    wt --title "APT-CACHER" --msgbox "Invalid APT-Cacher address: $cacher\nUse an IP address or a host name"
  done
  APT_CACHER="$cacher"
}

step_verbose() {
  local verbose
  verbose=$(wt --title "VERBOSE MODE" --notags --default-item "${VERBOSE:-no}" --menu "Enable verbose mode?" "yes" "Yes" "no" "No") || return
  VERBOSE="$verbose"
}

settings_options() {
  run_steps step_onboot step_docker_support step_apt_cacher step_verbose
}

summary_options() {
  local parts=() list
  if [ "$ONBOOT" == "yes" ]; then
    parts+=("start at boot")
  fi
  if [ "$UNPRIVILEGED" == "1" ] && [ "$DOCKER_SUPPORT" == "yes" ]; then
    parts+=("Docker support")
  fi
  if [ -n "$APT_CACHER" ]; then
    parts+=("APT-Cacher $APT_CACHER")
  fi
  if [ "$VERBOSE" == "yes" ]; then
    parts+=("verbose")
  fi
  list=$(join_list "${parts[@]}")
  echo "${list:-none}"
}

# Render nodes only, like tools/lxc-gpu.sh. Hidden without a GPU: unlike a USB key, one can't be plugged in meanwhile
step_gpu() {
  local menu=("none" "None") path gpu
  for path in /dev/dri/renderD*; do
    [ -e "$path" ] || continue
    menu+=("${path##*/}" "${path##*/} ($(gpu_vendor "${path##*/}"))")
  done
  if [ ${#menu[@]} -eq 2 ]; then
    GPU_DEVICE=""
    return 2
  fi
  gpu=$(wt --title "GPU DEVICE" --notags --default-item "${GPU_DEVICE:-none}" --menu "Give the container a GPU?\nFor hardware acceleration (transcoding, AI)" "${menu[@]}") || return
  if [ "$gpu" == "none" ]; then
    gpu=""
  fi
  GPU_DEVICE="$gpu"
}

step_tun() {
  local tun text="Give the container the TUN device?\nNeeded by VPNs and other network tunnels"
  if [ -n "${var_tun_note:-}" ]; then
    text+="\n$var_tun_note"
  fi
  tun=$(wt --title "TUN DEVICE" --notags --default-item "${TUN:-no}" --menu "$text" "yes" "Yes" "no" "No") || return
  TUN="$tun"
}

# Listed again at each Yes, so a device plugged in meanwhile shows up
step_usb_serial() {
  local list path name answer selected rc
  while true; do
    answer=$(wt --title "USB SERIAL DEVICES" --notags --default-item "$([ -n "$USB_DEVICES" ] && echo yes || echo no)" --menu "Give the container USB serial devices?\nZigbee or Z-Wave keys, modems, UPS cables" "yes" "Yes" "no" "No") || return
    if [ "$answer" == "no" ]; then
      USB_DEVICES=""
      return
    fi
    list=()
    for path in /dev/serial/by-id/*; do
      [ -e "$path" ] || continue
      name="${path##*/}"
      list+=("$name" "$(basename "$(readlink -f "$path")")" "$([[ " $USB_DEVICES " == *" $name "* ]] && echo ON || echo OFF)")
    done
    if [ ${#list[@]} -eq 0 ]; then
      wt --title "USB SERIAL DEVICES" --msgbox "No USB serial device is plugged into this host.\nPlug one in and choose Yes again, or use the dedicated tool later."
      continue
    fi
    rc=0
    selected=$(wt --title "USB SERIAL DEVICES" --separate-output --checklist "Choose the devices to give to the container\nUse Space to select a device" "${list[@]}") || rc=$?
    case $rc in
      0) USB_DEVICES="${selected//$'\n'/ }"; return ;;
      # Back returns to the question
      1) continue ;;
      *) return "$rc" ;;
    esac
  done
}

settings_devices() {
  run_steps step_gpu step_tun step_usb_serial
}

summary_devices() {
  local parts=() list
  if [ -n "$GPU_DEVICE" ]; then
    parts+=("GPU")
  fi
  if [ "$TUN" == "yes" ]; then
    parts+=("TUN")
  fi
  if [ -n "$USB_DEVICES" ]; then
    parts+=("USB serial ($(wc -w <<< "$USB_DEVICES"))")
  fi
  list=$(join_list "${parts[@]}")
  echo "${list:-none}"
}

settings_app() {
  run_steps "${app_settings[@]}"
}

# The values of the ct script's app_summary lines
summary_app() {
  local values=() line
  while IFS= read -r line; do
    values+=("${line#*: }")
  done <<< "$(app_summary)"
  join_list "${values[@]}"
}

# Runs the given steps: Next goes on, Back returns to the previous shown step, ESC exits
run_steps() {
  local steps=("$@") i=0 dir=1 rc
  # Read by wt
  local WT_NAV="yes"
  while [ $i -lt ${#steps[@]} ]; do
    rc=0
    "${steps[i]}" || rc=$?
    case $rc in
      0) dir=1 ;;
      1) dir=-1 ;;
      255) exit-script ;;
    esac
    # 2 = nothing shown: keep going the same way
    i=$((i + dir))
    if [ $i -lt 0 ]; then
      return 1
    fi
  done
}

# Category name, then its summary
menu_line() {
  printf '%-11s %s' "$1" "$2"
}

# Every category with its current values: Create goes on, a category runs its steps then comes back here
settings_menu() {
  local menu choice
  while true; do
    # The shell shows between two windows, keep it blank
    clear
    menu=(
      "create" ">> Create the ${APP} LXC"
      "general" "$(menu_line General "$(summary_general)")"
      "access" "$(menu_line Access "$(summary_access)")"
      "resources" "$(menu_line Resources "$(summary_resources)")"
      "network" "$(menu_line Network "$(summary_network)")"
      "dns" "$(menu_line DNS "$(summary_dns)")"
      "options" "$(menu_line Options "$(summary_options)")"
      "devices" "$(menu_line Devices "$(summary_devices)")"
    )
    if [ -n "${app_settings[*]:-}" ]; then
      menu+=("app" "$(menu_line "$APP" "$(summary_app)")")
    fi
    choice=$(wt --title "SETTINGS" --notags --ok-button Select --cancel-button Exit \
      --menu "Create the container or choose what to change" "${menu[@]}") || exit-script
    # Back from the first step of a category returns 1: this menu shows again
    case "$choice" in
      create)
        # The ct script's own checks on the chosen settings, if any
        if declare -F app_check >/dev/null && ! app_check; then
          continue
        fi
        if disk_fits "$DISK_SIZE" || disk_space_warning "$DISK_SIZE"; then
          return
        fi ;;
      general) settings_general || true ;;
      access) settings_access || true ;;
      resources) settings_resources || true ;;
      network) settings_network || true ;;
      dns) settings_dns || true ;;
      options) settings_options || true ;;
      devices) settings_devices || true ;;
      app) settings_app || true ;;
    esac
  done
}

# "Label: value" lines, in the steps' order
settings_summary() {
  echo "Distribution: $var_os"
  echo "${var_os^} version: $var_os_version"
  echo "Container ID: $CT_ID"
  echo "Hostname: $CT_HOSTNAME"
  echo "Container type: $([ "$UNPRIVILEGED" == "1" ] && echo Unprivileged || echo Privileged)"
  echo "Root password: $([ -n "$ROOT_PASSWORD" ] && echo "********" || echo "automatic console login")"
  echo "Root SSH access: $([ "$ROOT_SSH" == "yes" ] && echo enabled || echo disabled)"
  echo "Template storage: $TEMPLATE_STORAGE"
  echo "Container storage: $CONTAINER_STORAGE"
  echo "Disk size: $DISK_SIZE GiB"
  echo "CPU cores: $CORE_COUNT"
  echo "RAM size: $RAM_SIZE MiB"
  echo "Bridge: $BRIDGE"
  echo "IPv4 address: $IPV4"
  if [ "$IPV4" != "dhcp" ]; then
    echo "Gateway: $GATEWAY"
  fi
  echo "IPv6: $([ "$DISABLE_IPV6" == "yes" ] && echo disabled || echo enabled)"
  echo "VLAN: ${VLAN:-none}"
  echo "MAC address: ${MAC:-generated}"
  echo "MTU: ${MTU:-default}"
  echo "DNS server: ${DNS_SERVER:-same as host}"
  echo "DNS search domain: ${SEARCH_DOMAIN:-same as host}"
  echo "Start at boot: $([ "$ONBOOT" == "yes" ] && echo enabled || echo disabled)"
  if [ "$UNPRIVILEGED" == "1" ]; then
    echo "Docker support: $([ "$DOCKER_SUPPORT" == "yes" ] && echo enabled || echo disabled)"
  fi
  if [ "$var_os" != "alpine" ]; then
    echo "APT-Cacher: ${APT_CACHER:-none}"
  fi
  echo "Verbose mode: $([ "$VERBOSE" == "yes" ] && echo enabled || echo disabled)"
  echo "Devices: $(summary_devices)"
  # App-specific lines, optionally defined by lxc/<app>.sh
  if declare -F app_summary >/dev/null; then
    app_summary
  fi
}

echo_settings() {
  local line
  while IFS= read -r line; do
    echo -e "${DGN}${line%%: *}: ${BGN}${line#*: }${CL}"
  done <<< "$(settings_summary)"
}

choose_settings() {
  NEXTID=$(pvesh get /cluster/nextid)
  # timedatectl is more reliable than /etc/timezone on newer systemd-based
  # hosts (e.g. Debian 13); fall back to /etc/timezone for older systems
  if command -v timedatectl >/dev/null 2>&1; then
    TIMEZONE=$(timedatectl show --value --property=Timezone 2>/dev/null || echo "UTC")
  elif [ -f /etc/timezone ]; then
    TIMEZONE=$(cat /etc/timezone)
  else
    TIMEZONE="UTC"
  fi
  host_lists
  # Every setting gets a value before the menu shows them
  default_settings
  settings_menu
  header_info
  echo_settings
  echo -e "${BL}Creating the ${APP} LXC using the above settings${CL}"
  msg_warn "Keep this Shell open until the end: leaving it stops the install"
}

create_container() {
  # nesting on privileged containers too: systemd fails without it
  local features="nesting=1" net0 options template_search templates template
  if [ "$UNPRIVILEGED" == "1" ] && [ "$DOCKER_SUPPORT" == "yes" ]; then
    features+=",keyctl=1"
  fi
  net0="name=eth0,bridge=$BRIDGE,firewall=1,ip=$IPV4"
  if [ "$IPV4" != "dhcp" ]; then
    net0+=",gw=$GATEWAY"
  fi
  net0+="${MAC:+,hwaddr=$MAC}${VLAN:+,tag=$VLAN}${MTU:+,mtu=$MTU}"
  options=(
    -features "$features"
    -hostname "$CT_HOSTNAME"
    -tags salvialf-pve-scripts
    -net0 "$net0"
    -onboot "$([ "$ONBOOT" == "yes" ] && echo 1 || echo 0)"
    -cores "$CORE_COUNT"
    -memory "$RAM_SIZE"
    -unprivileged "$UNPRIVILEGED"
  )
  if [ -n "$DNS_SERVER" ]; then
    options+=(-nameserver "$DNS_SERVER")
  fi
  if [ -n "$SEARCH_DOMAIN" ]; then
    options+=(-searchdomain "$SEARCH_DOMAIN")
  fi
  if [ -n "$ROOT_PASSWORD" ]; then
    options+=(-password "$ROOT_PASSWORD")
  fi

  msg_info "Updating LXC template list"
  pveam update >/dev/null
  msg_ok "Updated LXC template list"

  template_search="${var_os}-${var_os_version}"
  # Keep only the host's architecture (PVE 9 also lists arm64 templates)
  # || true: with set -E, an error here would be read as a template
  mapfile -t templates < <(
    pveam available -section system |
      awk '{print $2}' |
      grep "_$(dpkg --print-architecture)\.tar\." |
      sed -n "s/.*\($template_search.*\)/\1/p" |
      sort -t - -k 2 -V || true
  )
  if [ ${#templates[@]} -eq 0 ]; then
    msg_error "Unable to find a template when searching for '$template_search'"
    exit 1
  fi
  template="${templates[-1]}"

  if ! pveam list "$TEMPLATE_STORAGE" | grep -q "$template"; then
    msg_info "Downloading LXC template"
    if ! pveam download "$TEMPLATE_STORAGE" "$template" >/dev/null; then
      msg_error "A problem occurred while downloading the LXC template"
      exit 1
    fi
    msg_ok "Downloaded LXC template"
  fi

  msg_info "Creating LXC container"
  if ! pct create "$CT_ID" "${TEMPLATE_STORAGE}:vztmpl/${template}" "${options[@]}" -rootfs "$CONTAINER_STORAGE:$DISK_SIZE" >/dev/null; then
    msg_error "A problem occurred while trying to create the container"
    exit 1
  fi
  msg_ok "LXC container ${BL}$CT_ID${CL} ${GN}was successfully created"
}

download_tool() {
  if [ -z "${TOOLS_FUNC:-}" ]; then
    TOOLS_FUNC=$(curl -fsSL https://raw.githubusercontent.com/Salvialf/pve-scripts/main/lib/tools.func) || {
      msg_error "Unable to download tools.func"
      exit 1
    }
  fi
  TOOL_SCRIPTS[$1]=$(curl -fsSL "https://raw.githubusercontent.com/Salvialf/pve-scripts/main/tools/$1") || {
    msg_error "Unable to download $1"
    exit 1
  }
}

# Runs tools/$1 on the container being created, with the functions already loaded here. The other arguments are the tool's variables
run_tool() {
  env CT_ID="$CT_ID" HEADER="no" COMMON_FUNC="$COMMON_FUNC" TOOLS_FUNC="$TOOLS_FUNC" "${@:2}" bash -c "${TOOL_SCRIPTS[$1]}"
}

# Downloaded before anything is created, so a failure leaves no container behind
download_install_files() {
  local install_file
  if [ "$var_os" == "alpine" ]; then
    install_file="alpine-install.func"
  else
    install_file="debian-install.func"
  fi
  INSTALL_FUNC=$(curl -fsSL "https://raw.githubusercontent.com/Salvialf/pve-scripts/main/lib/$install_file") || {
    msg_error "Unable to download $install_file"
    exit 1
  }
  INSTALL_SCRIPT=$(curl -fsSL "https://raw.githubusercontent.com/Salvialf/pve-scripts/main/install/${APP_SLUG}-install.sh") || {
    msg_error "Unable to download ${APP_SLUG}-install.sh"
    exit 1
  }
  declare -gA TOOL_SCRIPTS=()
  device_tools download_tool
}

# Calls $1 for each device setting with its tool and the tool's variables: download_tool, then run_tool before the first start
device_tools() {
  if [ -n "$GPU_DEVICE" ]; then
    "$1" lxc-gpu.sh GPU_DEVICE="$GPU_DEVICE"
  fi
  if [ "$TUN" == "yes" ]; then
    "$1" lxc-tun.sh
  fi
  if [ -n "$USB_DEVICES" ]; then
    "$1" lxc-usb-serial.sh USB_DEVICES="$USB_DEVICES"
  fi
}

start_container() {
  local rootfs="/var/lib/lxc/$CT_ID/rootfs"
  msg_info "Starting LXC container"
  pct start "$CT_ID"
  msg_ok "Started LXC container"
  # Fix Debian 13 LXC template bug where / is owned by nobody:nogroup
  # (must be done from the host, an unprivileged container cannot chown /)
  if [ -d "$rootfs" ] && [ "$(stat -c '%U' "$rootfs")" != "root" ]; then
    chown root:root "$rootfs" 2>/dev/null || true
  fi
}

wait_for_network() {
  local i ip=""
  msg_info "Waiting for the container network"
  for ((i = 30; i > 0; i--)); do
    ip=$(get_ip 2>/dev/null) || true
    if [ -n "$ip" ]; then
      break
    fi
    sleep 1
  done
  if [ -z "$ip" ]; then
    msg_error "No IPv4 address after 30 seconds, check the network settings"
    exit 1
  fi
  msg_ok "Container network connected: ${BL}$ip"
}

# Internet over IPv4, required by the install, IPv6 only reported, then DNS
network_check() {
  local prompt resolved_ip
  msg_info "Checking the container's Internet access"
  if ct_exec ping -c 1 -W 1 1.1.1.1 &>/dev/null; then
    msg_ok "IPv4 Internet connected"
  else
    msg_error "No IPv4 Internet access, ping to 1.1.1.1 failed"
    read -r -p "Some networks block ping, continue anyway? <y/N> " prompt
    if [[ ! "${prompt,,}" =~ ^(y|yes)$ ]]; then
      exit 1
    fi
  fi
  if [ "$DISABLE_IPV6" != "yes" ]; then
    if ct_exec ping6 -c 1 -W 1 2606:4700:4700::1111 &>/dev/null; then
      msg_ok "IPv6 Internet connected"
    else
      msg_warn "No IPv6 Internet access"
    fi
  fi
  resolved_ip=$(ct_exec getent hosts github.com | awk '{ print $1; exit }') || true
  if [ -z "$resolved_ip" ]; then
    msg_error "Unable to resolve github.com, check the DNS settings"
    exit 1
  fi
  msg_ok "DNS resolved github.com to ${BL}$resolved_ip"
}

run_install() {
  # The ct script's common.func, the same version as the host's
  export FUNCTIONS_FILE_PATH="$COMMON_FUNC"$'\n'"$INSTALL_FUNC"
  # Read by the install functions inside the container
  export APP APP_SLUG TIMEZONE ROOT_PASSWORD ROOT_SSH DISABLE_IPV6 APT_CACHER VERBOSE
  # The install script runs in bash, missing from the Alpine template
  if [ "$var_os" == "alpine" ] && ! ct_exec apk add bash &>/dev/null; then
    msg_error "Unable to install bash in the container, check its network settings"
    exit 1
  fi
  lxc-attach -n "$CT_ID" -- bash -c "$INSTALL_SCRIPT" || exit
}

# Creates and starts the container, then runs install/<app>-install.sh inside it
build_container() {
  download_install_files
  create_container
  device_tools run_tool
  start_container
  wait_for_network
  network_check
  run_install
}

# With the terminal as input, lxc-attach can kill the command with SIGHUP when its output goes elsewhere
ct_exec() {
  pct exec "$CT_ID" -- "$@" </dev/null
}

get_ip() {
  ct_exec ip a s dev eth0 | awk '/inet / {print $2}' | cut -d/ -f1
}

description() {
  local repo="https://github.com/Salvialf/pve-scripts"
  pct set "$CT_ID" -description "$(cat <<EOF
<div align="center">
<a href="$repo" target="_blank"><img src="https://raw.githubusercontent.com/Salvialf/pve-scripts/main/logos/pve-scripts.svg" alt="pve-scripts"></a>

## ${APP} LXC

Created with <a href="$repo" target="_blank">pve-scripts</a> &middot; <a href="$repo/blob/main/docs/lxc/${APP_SLUG}.md" target="_blank">Documentation</a>
</div>

**Update:** run \`update\` in the container's console.

**Devices:** host devices can be added or removed with the <a href="$repo#tools" target="_blank">tools</a>.
EOF
)"
}
