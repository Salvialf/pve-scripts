#!/usr/bin/env bash

# Disk, CPU, RAM and OS come from the ct script's var_* variables
default_settings() {
  # Reset to the ct script's values, which the advanced steps change
  DEFAULT_OS="${DEFAULT_OS:-$var_os}"
  DEFAULT_VERSION="${DEFAULT_VERSION:-$var_version}"
  var_os="$DEFAULT_OS"
  var_version="$DEFAULT_VERSION"
  UNPRIVILEGED="1"
  ROOT_PASSWORD=""
  CT_ID=$NEXTID
  CT_HOSTNAME=$APP_SLUG
  DISK_SIZE="$var_disk"
  CORE_COUNT="$var_cpu"
  RAM_SIZE="$var_ram"
  IPV4="dhcp"
  GATEWAY=""
  APT_CACHER=""
  DISABLE_IPV6="no"
  MTU=""
  SEARCH_DOMAIN=""
  DNS_SERVER=""
  MAC=""
  VLAN=""
  ROOT_SSH="no"
  VERBOSE="no"
  # The ct script's app_settings values, if any
  if declare -F app_default_settings >/dev/null; then
    app_default_settings
  fi
}

# Succeeds when $3 is a whole number between $1 and $2 (9 digits at most, so test can compare it)
is_number_in() {
  [[ "$3" =~ ^[0-9]{1,9}$ ]] && [ "$3" -ge "$1" ] && [ "$3" -le "$2" ]
}

is_ipv4() {
  local octet='(25[0-5]|2[0-4][0-9]|1?[0-9]?[0-9])'
  [[ "$1" =~ ^($octet\.){3}$octet$ ]]
}

# Proxmox's hostname rule: dot-separated labels of letters, digits and inner hyphens, 255 characters at most
is_dns_name() {
  local label='[a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?'
  [ ${#1} -le 255 ] && [[ "$1" =~ ^($label\.)*$label$ ]]
}

# pvesm sizes are in KiB
kib_to_gib() {
  awk -v kib="$1" 'BEGIN {printf "%.2f", kib / 1048576}'
}

# Prints the storage to use, asking only when there are several
# Arguments: pvesm status lines without header, window title, window text, storage to preselect (the first one if empty)
select_storage() {
  local menu=() name type free
  # pvesm columns: Name Type Status Total Used Available %, sizes in KiB
  while read -r name type _ _ _ free _; do
    menu+=("$name" "$(printf '%-10s %s GiB free' "$type" "$(kib_to_gib "$free")")")
  done <<< "$1"
  if [ ${#menu[@]} -eq 2 ]; then
    echo "${menu[0]}"
    return
  fi
  wt --title "$2" --default-item "$4" --menu "$3" "${menu[@]}"
}

# Reads the host's storages and bridges once, before any window: a missing one stops the script here
host_lists() {
  local entry
  # pvesm is slow to start, one call per content type. An error leaves the list empty, reported below
  TEMPLATE_STORAGE_LIST=$(pvesm status -content vztmpl | awk 'NR>1') || true
  CONTAINER_STORAGE_LIST=$(pvesm status -content rootdir | awk 'NR>1') || true
  if [ -z "$TEMPLATE_STORAGE_LIST" ]; then
    msg_error "Unable to detect a valid Template Storage location."
    exit 1
  fi
  if [ -z "$CONTAINER_STORAGE_LIST" ]; then
    msg_error "Unable to detect a valid Container Storage location."
    exit 1
  fi
  BRIDGE_NAMES=()
  BRIDGE_TYPES=()
  # any_bridge: Linux/OVS bridges and SDN vnets
  # || true: with set -E, an error here would be read as a bridge
  while read -r entry; do
    BRIDGE_NAMES+=("$(sed -n 's/.*"iface":"\([^"]*\)".*/\1/p' <<< "$entry")")
    BRIDGE_TYPES+=("$(sed -n 's/.*"type":"\([^"]*\)".*/\1/p' <<< "$entry")")
  done < <(pvesh get "/nodes/$(hostname -s)/network" --type any_bridge --output-format json | grep -o '{[^}]*}' || true)
  if [ ${#BRIDGE_NAMES[@]} -eq 0 ]; then
    msg_error "Unable to detect a network bridge on this host."
    exit 1
  fi
}

# Succeeds when $1 GiB fits in the container storage's free space
disk_fits() {
  awk -v size="$1" -v kib="$CONTAINER_STORAGE_FREE" 'BEGIN {exit !(size * 1048576 <= kib)}'
}

# Asks whether to go on with a $1 GiB disk that doesn't fit, fails if the user doesn't
disk_space_warning() {
  wt --defaultno --title "DISK SPACE" --yesno "Disk size: $1 GiB\nFree on $CONTAINER_STORAGE: $(kib_to_gib "$CONTAINER_STORAGE_FREE") GiB\nContinue anyway?"
}

# step_* functions: one settings window each for run_steps, returning 0 Next, 1 Back, 255 ESC or 2 when nothing is shown

step_distribution() {
  if [ "$var_os" == "alpine" ] || [ "${var_os_locked:-no}" == "yes" ]; then
    return 2
  fi
  local os
  os=$(wt --title "DISTRIBUTION" --notags --default-item "$var_os" --menu "Choose the distribution" \
    "debian" "Debian" \
    "ubuntu" "Ubuntu") || return
  var_os="$os"
}

step_version() {
  local version
  if [ "$var_os" == "debian" ]; then
    version=$(wt --title "DEBIAN VERSION" --notags --default-item "$var_version" --menu "Choose the Debian version" \
      "12" "Bookworm (12)" \
      "13" "Trixie (13)") || return
  elif [ "$var_os" == "ubuntu" ]; then
    version=$(wt --title "UBUNTU VERSION" --notags --default-item "$var_version" --menu "Choose the Ubuntu version" \
      "20.04" "Focal (20.04)" \
      "22.04" "Jammy (22.04)" \
      "24.04" "Noble (24.04)") || return
  else
    return 2
  fi
  var_version="$version"
}

step_ct_id() {
  local id="${CT_ID:-$NEXTID}"
  while true; do
    id=$(wt --title "CONTAINER ID" --inputbox "Set the container ID" "$id") || return
    id="${id:-$NEXTID}"
    if ! is_number_in 100 999999999 "$id"; then
      wt --title "CONTAINER ID" --msgbox "Invalid container ID: $id\nUse a number, 100 or more"
    # Checks every VM and container of the cluster, pct status only knows containers
    elif ! pvesh get /cluster/nextid --vmid "$id" &>/dev/null; then
      wt --title "CONTAINER ID" --msgbox "Container ID $id is already in use\nby a VM or a container"
    else
      break
    fi
  done
  CT_ID="$id"
}

step_hostname() {
  local name="${CT_HOSTNAME:-$APP_SLUG}"
  while true; do
    name=$(wt --title "HOSTNAME" --inputbox "Set the hostname" "$name") || return
    name="${name:-$APP_SLUG}"
    is_dns_name "$name" && break
    wt --title "HOSTNAME" --msgbox "Invalid hostname: $name\nUse letters, digits, hyphens and dots"
  done
  CT_HOSTNAME="${name,,}"
}

step_ct_type() {
  local unprivileged
  unprivileged=$(wt --title "CONTAINER TYPE" --notags --default-item "$UNPRIVILEGED" --menu "Choose the container type" \
    "1" "Unprivileged" \
    "0" "Privileged") || return
  UNPRIVILEGED="$unprivileged"
}

step_password() {
  local pw1="$ROOT_PASSWORD" pw2
  while true; do
    # Prefilled with the current password, so going back and forth keeps it
    pw1=$(wt --title "ROOT PASSWORD" --passwordbox "Set the root password, required for root SSH access\nLeave blank for automatic console login" "$pw1") || return
    if [ -z "$pw1" ]; then
      ROOT_PASSWORD=""
      return 0
    fi
    # Already confirmed
    if [ "$ROOT_PASSWORD" == "$pw1" ]; then
      return 0
    fi
    if [[ "$pw1" == *" "* ]]; then
      wt --title "ROOT PASSWORD" --msgbox "Password cannot contain spaces. Please try again."
      continue
    fi
    if [ ${#pw1} -lt 5 ]; then
      wt --title "ROOT PASSWORD" --msgbox "Password must be at least 5 characters long. Please try again."
      continue
    fi
    # Back from the confirmation asks the password again
    pw2=$(wt --title "ROOT PASSWORD" --passwordbox "Confirm the root password") || { [ $? -eq 1 ] && continue; return 255; }
    if [ "$pw1" == "$pw2" ]; then
      ROOT_PASSWORD="$pw1"
      return 0
    fi
    wt --title "ROOT PASSWORD" --msgbox "Passwords do not match. Please try again."
  done
}

# Root SSH access needs a password
step_ssh() {
  if [ -z "$ROOT_PASSWORD" ]; then
    ROOT_SSH="no"
    return 2
  fi
  local ssh
  ssh=$(wt --title "ROOT SSH ACCESS" --notags --default-item "${ROOT_SSH:-no}" --menu "Enable root SSH access?" "yes" "Yes" "no" "No") || return
  ROOT_SSH="$ssh"
}

# Shown only when there are several
step_template_storage() {
  local storage
  storage=$(select_storage "$TEMPLATE_STORAGE_LIST" "TEMPLATE STORAGE" "Choose the storage for the container template" "${TEMPLATE_STORAGE:-}") || return
  TEMPLATE_STORAGE="$storage"
  [ "$(wc -l <<< "$TEMPLATE_STORAGE_LIST")" -gt 1 ] || return 2
}

# Shown only when there are several, keeps the storage's free space in KiB
step_container_storage() {
  local storage
  storage=$(select_storage "$CONTAINER_STORAGE_LIST" "CONTAINER STORAGE" "Choose the storage for the container disk" "${CONTAINER_STORAGE:-}") || return
  CONTAINER_STORAGE="$storage"
  CONTAINER_STORAGE_FREE=$(awk -v storage="$storage" '$1 == storage {print $6}' <<< "$CONTAINER_STORAGE_LIST")
  [ "$(wc -l <<< "$CONTAINER_STORAGE_LIST")" -gt 1 ] || return 2
}

step_disk_size() {
  local size="${DISK_SIZE:-$var_disk}"
  while true; do
    size=$(wt --title "DISK SIZE" --inputbox "Set the disk size in GiB\n$(kib_to_gib "$CONTAINER_STORAGE_FREE") GiB free on $CONTAINER_STORAGE" "$size") || return
    size="${size:-$var_disk}"
    if ! [[ "$size" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
      wt --title "DISK SIZE" --msgbox "Invalid disk size: $size\nUse a number of GiB, e.g. 16"
      continue
    fi
    disk_fits "$size" && break
    # No on the warning asks the size again
    disk_space_warning "$size" && break
  done
  DISK_SIZE="$size"
}

# Default mode only, where the disk size isn't asked: No goes back
step_disk_space() {
  disk_fits "$DISK_SIZE" && return 2
  disk_space_warning "$DISK_SIZE"
}

step_cpu() {
  local cores="${CORE_COUNT:-$var_cpu}"
  while true; do
    cores=$(wt --title "CPU CORES" --inputbox "Set the number of CPU cores" "$cores") || return
    cores="${cores:-$var_cpu}"
    is_number_in 1 8192 "$cores" && break
    wt --title "CPU CORES" --msgbox "Invalid number of CPU cores: $cores\nUse a whole number from 1 to 8192"
  done
  CORE_COUNT="$cores"
}

step_ram() {
  local ram="${RAM_SIZE:-$var_ram}"
  while true; do
    ram=$(wt --title "RAM" --inputbox "Set the RAM size in MiB" "$ram") || return
    ram="${ram:-$var_ram}"
    [[ "$ram" =~ ^[0-9]{1,9}$ ]] && [ "$ram" -ge 16 ] && break
    wt --title "RAM" --msgbox "Invalid RAM size: $ram\nUse a whole number of MiB, 16 or more"
  done
  RAM_SIZE="$ram"
}

step_bridge() {
  if [ ${#BRIDGE_NAMES[@]} -eq 1 ]; then
    BRIDGE="${BRIDGE_NAMES[0]}"
    return 2
  fi
  local menu=() bridge i
  for i in "${!BRIDGE_NAMES[@]}"; do
    menu+=("${BRIDGE_NAMES[i]}" "${BRIDGE_TYPES[i]}")
  done
  bridge=$(wt --title "BRIDGE" --default-item "${BRIDGE:-vmbr0}" --menu "Choose the network bridge" "${menu[@]}") || return
  BRIDGE="$bridge"
}

step_ipv4() {
  local ip="${IPV4:-dhcp}"
  while true; do
    ip=$(wt --title "IPv4 ADDRESS" --inputbox "Set a static IPv4 address, e.g. 192.168.1.50/24\nKeep dhcp for automatic addressing" "$ip") || return
    ip="${ip:-dhcp}"
    [ "$ip" == "dhcp" ] && break
    is_ipv4 "${ip%/*}" && [[ "$ip" =~ /([0-9]|[12][0-9]|3[0-2])$ ]] && break
    wt --title "IPv4 ADDRESS" --msgbox "Invalid IPv4 address: $ip\nUse the format 192.168.1.50/24, or dhcp"
  done
  IPV4="$ip"
}

# GATEWAY is kept with dhcp, so switching back finds it again
step_gateway() {
  if [ "$IPV4" == "dhcp" ]; then
    return 2
  fi
  local gateway="$GATEWAY"
  # The host's gateway is the right one when the container shares its network
  gateway="${gateway:-$(ip route show default | awk '{print $3; exit}')}" || true
  while true; do
    gateway=$(wt --title "GATEWAY" --inputbox "Set the gateway IPv4 address, e.g. 192.168.1.1\nPrefilled with the host's gateway" "$gateway") || return
    is_ipv4 "$gateway" && break
    wt --title "GATEWAY" --msgbox "Invalid gateway address: $gateway\nUse the format 192.168.1.1"
  done
  GATEWAY="$gateway"
}

step_ipv6() {
  local disable
  disable=$(wt --title "IPv6" --notags --default-item "${DISABLE_IPV6:-no}" --menu "Disable IPv6?" "yes" "Yes" "no" "No") || return
  DISABLE_IPV6="$disable"
}

step_vlan() {
  local vlan="$VLAN"
  while true; do
    vlan=$(wt --title "VLAN" --inputbox "Set the VLAN tag\nLeave blank for none" "$vlan") || return
    [ -z "$vlan" ] && break
    is_number_in 1 4094 "$vlan" && break
    wt --title "VLAN" --msgbox "Invalid VLAN tag: $vlan\nUse a number from 1 to 4094, or leave blank"
  done
  VLAN="$vlan"
}

step_mac() {
  local mac="$MAC"
  while true; do
    mac=$(wt --title "MAC ADDRESS" --inputbox "Set the MAC address\nLeave blank for a generated one" "$mac") || return
    [ -z "$mac" ] && break
    # Proxmox refuses multicast addresses: the second hex digit must be even
    [[ "$mac" =~ ^[a-fA-F0-9][02468aceACE](:[a-fA-F0-9]{2}){5}$ ]] && break
    wt --title "MAC ADDRESS" --msgbox "Invalid MAC address: $mac\nUse a unicast MAC, e.g. 02:00:00:00:00:01"
  done
  MAC="$mac"
}

step_mtu() {
  local mtu="$MTU"
  while true; do
    mtu=$(wt --title "MTU" --inputbox "Set the interface MTU size\nLeave blank for default" "$mtu") || return
    [ -z "$mtu" ] && break
    is_number_in 64 65535 "$mtu" && break
    wt --title "MTU" --msgbox "Invalid MTU size: $mtu\nUse a number from 64 to 65535, or leave blank"
  done
  MTU="$mtu"
}

step_dns_server() {
  local server
  server=$(wt --title "DNS SERVER" --inputbox "Set the DNS server IP address\nLeave blank to use the host's" "$DNS_SERVER") || return
  DNS_SERVER="$server"
}

step_search_domain() {
  local domain
  domain=$(wt --title "DNS SEARCH DOMAIN" --inputbox "Set the DNS search domain\nLeave blank to use the host's" "$SEARCH_DOMAIN") || return
  SEARCH_DOMAIN="$domain"
}

step_apt_cacher() {
  if [ "$var_os" == "alpine" ]; then
    APT_CACHER=""
    return 2
  fi
  local cacher="$APT_CACHER"
  while true; do
    cacher=$(wt --title "APT-CACHER" --inputbox "Set the APT-Cacher IP address\nLeave blank to not use one" "$cacher") || return
    [ -z "$cacher" ] && break
    is_dns_name "$cacher" && break
    wt --title "APT-CACHER" --msgbox "Invalid APT-Cacher address: $cacher\nUse an IP address or a host name"
  done
  APT_CACHER="$cacher"
}

step_verbose() {
  local verbose
  verbose=$(wt --title "VERBOSE MODE" --notags --default-item "${VERBOSE:-no}" --menu "Enable verbose mode?" "yes" "Yes" "no" "No") || return
  VERBOSE="$verbose"
}

step_confirm() {
  wt --title "CONFIRMATION" --yes-button Create --no-button Back --yesno "Ready to create the ${APP} LXC?\n\n$(settings_summary)"
}

# Runs the given steps: Next goes on, Back returns to the previous shown step, ESC exits
run_steps() {
  local steps=("$@") i=0 dir=1 rc
  # Read by wt
  local WT_NAV="yes"
  while [ $i -lt ${#steps[@]} ]; do
    rc=0
    "${steps[i]}" || rc=$?
    case $rc in
      0) dir=1 ;;
      1) dir=-1 ;;
      255) exit-script ;;
    esac
    # 2 = nothing shown: keep going the same way
    i=$((i + dir))
    if [ $i -lt 0 ]; then
      return 1
    fi
  done
}

advanced_settings() {
  run_steps step_distribution step_version step_ct_id step_hostname \
    step_ct_type step_password step_ssh \
    step_template_storage step_container_storage step_disk_size step_cpu step_ram \
    step_bridge step_ipv4 step_gateway step_ipv6 step_vlan step_mac step_mtu \
    step_dns_server step_search_domain \
    step_apt_cacher step_verbose "${app_settings[@]}" step_confirm
}

# "Label: value" lines, in the steps' order
settings_summary() {
  echo "Distribution: $var_os"
  echo "${var_os^} version: $var_version"
  echo "Container ID: $CT_ID"
  echo "Hostname: $CT_HOSTNAME"
  echo "Container type: $([ "$UNPRIVILEGED" == "1" ] && echo Unprivileged || echo Privileged)"
  echo "Root password: $([ -n "$ROOT_PASSWORD" ] && echo "********" || echo "automatic console login")"
  echo "Root SSH access: $([ "$ROOT_SSH" == "yes" ] && echo enabled || echo disabled)"
  echo "Template storage: $TEMPLATE_STORAGE"
  echo "Container storage: $CONTAINER_STORAGE"
  echo "Disk size: $DISK_SIZE GiB"
  echo "CPU cores: $CORE_COUNT"
  echo "RAM size: $RAM_SIZE MiB"
  echo "Bridge: $BRIDGE"
  echo "IPv4 address: $IPV4"
  if [ "$IPV4" != "dhcp" ]; then
    echo "Gateway: $GATEWAY"
  fi
  echo "IPv6: $([ "$DISABLE_IPV6" == "yes" ] && echo disabled || echo enabled)"
  echo "VLAN: ${VLAN:-none}"
  echo "MAC address: ${MAC:-generated}"
  echo "MTU: ${MTU:-default}"
  echo "DNS server: ${DNS_SERVER:-same as host}"
  echo "DNS search domain: ${SEARCH_DOMAIN:-same as host}"
  if [ "$var_os" != "alpine" ]; then
    echo "APT-Cacher: ${APT_CACHER:-none}"
  fi
  echo "Verbose mode: $([ "$VERBOSE" == "yes" ] && echo enabled || echo disabled)"
  # App-specific lines, optionally defined by ct/<app>.sh
  if declare -F app_summary >/dev/null; then
    app_summary
  fi
}

echo_settings() {
  local line
  while IFS= read -r line; do
    echo -e "${DGN}${line%%: *}: ${BGN}${line#*: }${CL}"
  done <<< "$(settings_summary)"
}

install_script() {
  local rc mode
  pve_check
  shell_check
  root_check
  arch_check
  ssh_check

  # Pauses/resumes tteck's optional monitor-all.sh host ping service
  # if systemctl is-active -q ping-instances.service; then
  #   systemctl -q stop ping-instances.service
  # fi
  NEXTID=$(pvesh get /cluster/nextid)
  # timedatectl is more reliable than /etc/timezone on newer systemd-based
  # hosts (e.g. Debian 13); fall back to /etc/timezone for older systems
  if command -v timedatectl >/dev/null 2>&1; then
    TIMEZONE=$(timedatectl show --value --property=Timezone 2>/dev/null || echo "UTC")
  elif [ -f /etc/timezone ]; then
    TIMEZONE=$(cat /etc/timezone)
  else
    TIMEZONE="UTC"
  fi
  host_lists
  # Every setting gets a value before any window, advanced_settings prefills from them
  default_settings
  # Going back from the first step returns here
  while true; do
    # The shell shows between two windows, keep it blank
    clear
    rc=0
    wt --title "SETTINGS" --yesno "Use default settings?" --no-button Advanced || rc=$?
    if [ $rc -eq 255 ]; then
      exit-script
    elif [ $rc -eq 0 ]; then
      mode="default"
      default_settings
      run_steps step_template_storage step_container_storage step_disk_space step_bridge && break
    else
      mode="advanced"
      advanced_settings && break
    fi
  done
  header_info
  echo -e "${BL}Using ${mode^} Settings${CL}"
  echo_settings
  echo -e "${BL}Creating a ${APP} LXC using the above ${mode} settings${CL}"
}

create_container() {
  local template_search templates template
  msg_info "Updating LXC Template List"
  pveam update >/dev/null
  msg_ok "Updated LXC Template List"

  template_search="${var_os}-${var_version}"
  # Keep only the host's architecture (PVE 9 also lists arm64 templates)
  # || true: with set -E, an error here would be read as a template
  mapfile -t templates < <(
    pveam available -section system |
      awk '{print $2}' |
      grep "_$(dpkg --print-architecture)\.tar\." |
      sed -n "s/.*\($template_search.*\)/\1/p" |
      sort -t - -k 2 -V || true
  )
  if [ ${#templates[@]} -eq 0 ]; then
    msg_error "Unable to find a template when searching for '$template_search'."
    exit 1
  fi
  template="${templates[-1]}"

  if ! pveam list "$TEMPLATE_STORAGE" | grep -q "$template"; then
    msg_info "Downloading LXC Template"
    if ! pveam download "$TEMPLATE_STORAGE" "$template" >/dev/null; then
      msg_error "A problem occurred while downloading the LXC template."
      exit 1
    fi
    msg_ok "Downloaded LXC Template"
  fi

  msg_info "Creating LXC Container"
  if ! pct create "$CT_ID" "${TEMPLATE_STORAGE}:vztmpl/${template}" "${PCT_OPTIONS[@]}" -rootfs "$CONTAINER_STORAGE:$DISK_SIZE" >/dev/null; then
    msg_error "A problem occurred while trying to create the container."
    exit 1
  fi
  msg_ok "LXC Container ${BL}$CT_ID${CL} ${GN}was successfully created."
}

# Creates and starts the container, then runs install/<app>-install.sh inside it
build_container() {
  local net0 install_func
  if [ "$UNPRIVILEGED" == "1" ]; then
    FEATURES="keyctl=1,nesting=1"
  else
    FEATURES="nesting=1"
  fi

  TEMP_DIR=$(mktemp -d)
  pushd $TEMP_DIR >/dev/null
  if [ "$var_os" == "alpine" ]; then
    export FUNCTIONS_FILE_PATH="$(curl -s https://raw.githubusercontent.com/tteck/Proxmox/main/misc/alpine-install.func)"
  else
    install_func=$(curl -fsSL https://raw.githubusercontent.com/Salvialf/pve-scripts/main/lib/install.func) || {
      msg_error "Unable to download install.func"
      exit 1
    }
    # The ct script's common.func, the same version as the host's
    export FUNCTIONS_FILE_PATH="$COMMON_FUNC"$'\n'"$install_func"
  fi
  # Read by install.func inside the container
  export APP APP_SLUG TIMEZONE ROOT_PASSWORD ROOT_SSH DISABLE_IPV6 APT_CACHER VERBOSE

  net0="name=eth0,bridge=$BRIDGE,ip=$IPV4"
  if [ "$IPV4" != "dhcp" ]; then
    net0+=",gw=$GATEWAY"
  fi
  net0+="${MAC:+,hwaddr=$MAC}${VLAN:+,tag=$VLAN}${MTU:+,mtu=$MTU}"
  PCT_OPTIONS=(
    -features "$FEATURES"
    -hostname "$CT_HOSTNAME"
    -tags salvialf-pve-scripts
    -net0 "$net0"
    -onboot 1
    -cores "$CORE_COUNT"
    -memory "$RAM_SIZE"
    -unprivileged "$UNPRIVILEGED"
  )
  if [ -n "$DNS_SERVER" ]; then
    PCT_OPTIONS+=(-nameserver "$DNS_SERVER")
  fi
  if [ -n "$SEARCH_DOMAIN" ]; then
    PCT_OPTIONS+=(-searchdomain "$SEARCH_DOMAIN")
  fi
  if [ -n "$ROOT_PASSWORD" ]; then
    PCT_OPTIONS+=(-password "$ROOT_PASSWORD")
  fi
  create_container

  LXC_CONFIG=/etc/pve/lxc/${CT_ID}.conf
  if [ "$UNPRIVILEGED" == "0" ]; then
    cat <<EOF >>$LXC_CONFIG
# USB passthrough
lxc.cgroup2.devices.allow: a
lxc.cap.drop:
lxc.cgroup2.devices.allow: c 188:* rwm
lxc.cgroup2.devices.allow: c 189:* rwm
lxc.mount.entry: /dev/serial/by-id  dev/serial/by-id  none bind,optional,create=dir
lxc.mount.entry: /dev/ttyUSB0       dev/ttyUSB0       none bind,optional,create=file
lxc.mount.entry: /dev/ttyUSB1       dev/ttyUSB1       none bind,optional,create=file
lxc.mount.entry: /dev/ttyACM0       dev/ttyACM0       none bind,optional,create=file
lxc.mount.entry: /dev/ttyACM1       dev/ttyACM1       none bind,optional,create=file
EOF
  fi

  if [ "$UNPRIVILEGED" == "0" ]; then
    if [[ "$APP" == "Channels" || "$APP" == "Emby" || "$APP" == "ErsatzTV" || "$APP" == "Frigate" || "$APP" == "Jellyfin" || "$APP" == "Plex" || "$APP" == "Scrypted" || "$APP" == "Tdarr" || "$APP" == "Unmanic" || "$APP" == "Ollama" ]]; then
      cat <<EOF >>$LXC_CONFIG
# VAAPI hardware transcoding
lxc.cgroup2.devices.allow: c 226:0 rwm
lxc.cgroup2.devices.allow: c 226:128 rwm
lxc.cgroup2.devices.allow: c 29:0 rwm
lxc.mount.entry: /dev/fb0 dev/fb0 none bind,optional,create=file
lxc.mount.entry: /dev/dri dev/dri none bind,optional,create=dir
lxc.mount.entry: /dev/dri/renderD128 dev/dri/renderD128 none bind,optional,create=file
EOF
    fi
  else
    if [[ "$APP" == "Channels" || "$APP" == "Emby" || "$APP" == "ErsatzTV" || "$APP" == "Frigate" || "$APP" == "Jellyfin" || "$APP" == "Plex" || "$APP" == "Scrypted" || "$APP" == "Tdarr" || "$APP" == "Unmanic" || "$APP" == "Ollama" ]]; then
      if [[ -e "/dev/dri/renderD128" ]]; then
        if [[ -e "/dev/dri/card0" ]]; then
          cat <<EOF >>$LXC_CONFIG
# VAAPI hardware transcoding
dev0: /dev/dri/card0,gid=44
dev1: /dev/dri/renderD128,gid=104
EOF
        else
          cat <<EOF >>$LXC_CONFIG
# VAAPI hardware transcoding
dev0: /dev/dri/card1,gid=44
dev1: /dev/dri/renderD128,gid=104
EOF
        fi
      fi
    fi
  fi

  msg_info "Starting LXC Container"
  pct start "$CT_ID"
  msg_ok "Started LXC Container"
  # Fix Debian 13 LXC template bug where / is owned by nobody:nogroup
  # (must be done from the host, an unprivileged container cannot chown /)
  ROOTFS_MP="/var/lib/lxc/$CT_ID/rootfs"
  if [ -d "$ROOTFS_MP" ] && [ "$(stat -c '%U' "$ROOTFS_MP")" != "root" ]; then
    chown root:root "$ROOTFS_MP" 2>/dev/null || true
  fi
  if [ "$var_os" == "alpine" ]; then
    sleep 3
        pct exec "$CT_ID" -- /bin/sh -c 'cat <<EOF >/etc/apk/repositories
http://dl-cdn.alpinelinux.org/alpine/latest-stable/main
http://dl-cdn.alpinelinux.org/alpine/latest-stable/community
#http://dl-cdn.alpinelinux.org/alpine/v3.19/main
#http://dl-cdn.alpinelinux.org/alpine/v3.19/community
EOF'
    pct exec "$CT_ID" -- ash -c "apk add bash >/dev/null"
  fi
  lxc-attach -n "$CT_ID" -- bash -c "$(wget -qLO - https://raw.githubusercontent.com/Salvialf/pve-scripts/main/install/${APP_SLUG}-install.sh)" || exit

}

get_ip() {
  pct exec "$CT_ID" ip a s dev eth0 | awk '/inet / {print $2}' | cut -d/ -f1
}

