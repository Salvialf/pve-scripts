variables() {
  APP_SLUG=$(echo ${APP,,} | tr -d ' ') # default hostname and install/<slug>-install.sh name
  BACKTITLE="Salvialf PVE scripts - ${APP} LXC" # shown on every whiptail window
  newt_colors                                   # whiptail palette from the ct script's var_color_*
}

color() {
  YW=$(echo "\033[33m")
  BL=$(echo "\033[36m")
  RD=$(echo "\033[01;31m")
  BGN=$(echo "\033[4;92m")
  GN=$(echo "\033[1;92m")
  DGN=$(echo "\033[32m")
  CL=$(echo "\033[m")
  CM="${GN}✓${CL}"
  CROSS="${RD}✗${CL}"
  BFR="\\r\\033[K"
  HOLD=" "
}

catch_errors() {
  set -Eeuo pipefail
  trap 'error_handler $LINENO "$BASH_COMMAND"' ERR
}

error_handler() {
  local exit_code="$?"
  stop_spinner
  local line_number="$1"
  local command="$2"
  local error_message="${RD}[ERROR]${CL} in line ${RD}$line_number${CL}: exit code ${RD}$exit_code${CL}: while executing command ${YW}$command${CL}"
  echo -e "\n$error_message"
  # The function where the error happened
  if [ "${FUNCNAME[1]:-}" == "silent" ]; then
    echo "The silent function has suppressed the error, run the script with verbose mode enabled, which will provide more detailed output."
  fi
  echo
}

spinner() {
    local chars="/-\|"
    local spin_i=0
    printf "\e[?25l"
    while true; do
        printf "\r \e[36m%s\e[0m" "${chars:spin_i++%${#chars}:1}"
        sleep 0.1
    done
}

stop_spinner() {
  if [ -n "${SPINNER_PID:-}" ]; then
    kill "$SPINNER_PID" 2>/dev/null || true
  fi
  SPINNER_PID=""
  printf "\e[?25h"
}

msg_info() {
  local msg="$1"
  # The spinner would write over the command output
  if [ "${VERBOSE:-}" == "yes" ]; then
    echo -e " ${HOLD} ${YW}${msg}${CL}"
    return
  fi
  echo -ne " ${HOLD} ${YW}${msg}   "
  spinner &
  SPINNER_PID=$!
}

msg_ok() {
  stop_spinner
  local msg="$1"
  echo -e "${BFR} ${CM} ${GN}${msg}${CL}"
}

msg_error() {
  stop_spinner
  local msg="$1"
  echo -e "${BFR} ${CROSS} ${RD}${msg}${CL}"
}

msg_warn() {
  local msg="$1"
  echo -e "${BFR} ${YW}⚠ ${msg}${CL}"
}

shell_check() {
  if [[ "$(basename "$SHELL")" != "bash" ]]; then
    clear
    msg_error "Your default shell is currently not set to Bash. To use these scripts, please switch to the Bash shell."
    echo -e "\nExiting..."
    sleep 2
    exit
  fi
}

root_check() {
  if [[ "$(id -u)" -ne 0 || $(ps -o comm= -p $PPID) == "sudo" ]]; then
    clear
    msg_error "Please run this script as root."
    echo -e "\nExiting..."
    sleep 2
    exit
  fi
}

# Tested versions only, not a minimum: a new major has to be checked before it gets added
pve_check() {
  if ! pveversion | grep -Eq "pve-manager/(8\.[1-9]|9\.[0-9])"; then
    msg_error "This version of Proxmox Virtual Environment is not supported"
    echo -e "Requires Proxmox Virtual Environment Version 8.1 or later."
    echo -e "Exiting..."
    sleep 2
    exit
fi
}

arch_check() {
  if [ "$(dpkg --print-architecture)" != "amd64" ]; then
    echo -e "\n ${CROSS} This script will not work with PiMox! \n"
    echo -e "\n Visit https://github.com/asylumexp/Proxmox for ARM64 support. \n"
    echo -e "Exiting..."
    sleep 2
    exit
  fi
}

# Warns (without blocking) on a genuinely external SSH session: on PVE 9.x the Proxmox WebUI Shell also sets SSH_CLIENT, with a local client IP
ssh_check() {
  if command -v pveversion >/dev/null 2>&1 && [ -n "${SSH_CLIENT:+x}" ]; then
    local client_ip host_ip host_subnet client_subnet
    client_ip=$(awk '{print $1}' <<<"$SSH_CLIENT")
    host_ip=$(hostname -I | awk '{print $1}')

    # Local connection (Proxmox WebUI Shell or same machine): not a real remote SSH session
    if [[ "$client_ip" == "127.0.0.1" || "$client_ip" == "::1" || "$client_ip" == "$host_ip" ]]; then
      return
    fi

    # Same local subnet
    host_subnet=$(echo "$host_ip" | cut -d. -f1-3)
    client_subnet=$(echo "$client_ip" | cut -d. -f1-3)
    if [[ "$host_subnet" == "$client_subnet" ]]; then
      return
    fi

    msg_warn "Running via external SSH (client: $client_ip). For better stability, use the Proxmox Shell instead."
  fi
}

exit-script() {
  clear
  echo -e "⚠  User exited script \n"
  exit
}

# Colors whiptail after the app's logo: var_color_primary on the banner and accents, light or dark windows
newt_colors() {
  local primary="${var_color_primary:-}" screen="color235" surface text
  # No app color, or under 256 colors (ssh often sets TERM=xterm): keep whiptail's own palette
  if [ -z "$primary" ] || [ "$(tput colors 2>/dev/null || echo 0)" -lt 256 ]; then
    return
  fi
  if [ "${var_color_theme:-light}" == "dark" ]; then
    surface="color238"
    text="white"
  else
    surface="lightgray"
    text="black"
  fi
  local elements=(
    "root=white,$screen" "roottext=$primary,$surface" "helpline=white,$screen" "shadow=white,$screen"
    "window=$text,$surface" "border=$primary,$surface" "title=$primary,$surface" "label=$text,$surface"
    "textbox=$text,$surface" "acttextbox=$surface,$primary"
    "button=$surface,$primary" "actbutton=$primary,$surface" "compactbutton=$text,$surface"
    "checkbox=$text,$surface" "actcheckbox=$surface,$primary"
    "listbox=$text,$surface" "actlistbox=$surface,$primary" "sellistbox=$primary,$surface" "actsellistbox=$surface,$primary"
    "entry=$surface,$primary" "disentry=$surface,$primary"
  )
  export NEWT_COLORS="${elements[*]}"
}

# Wraps whiptail: centered backtitle, sizes added after the box text, the answer is returned on stdout
# The box option must be directly followed by its text
wt() {
  local args=() nav=() cols breaks backtitle box="" rc=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --inputbox | --yesno | --msgbox)
        box="$1"
        args+=("$1" "$2" 0 58); shift 2 ;;
      --passwordbox)
        box="$1"
        # newt's auto-size has no case for passwordbox and hides the text: 8 rows for one line, plus one per \n
        breaks="${2//\\n/}"
        args+=("$1" "$2" $(((${#2} - ${#breaks}) / 2 + 8)) 58); shift 2 ;;
      --menu)
        box="$1"
        args+=("$1" "$2" 0 58 0); shift 2
        # A space each side of the descriptions, so the highlight doesn't stick to the text
        while [ $# -gt 0 ]; do
          args+=("$1" " $2 "); shift 2
        done ;;
      *)
        args+=("$1"); shift ;;
    esac
  done
  # stdout is captured by the caller, ask the terminal directly
  read -r _ cols < <(stty size </dev/tty)
  # Centered, then padded to the full width so newt_colors' roottext background makes a banner
  backtitle="$(printf '%*s%s' $(((cols - ${#BACKTITLE}) / 2)) '' "$BACKTITLE")"
  # Set by run_steps: Next/Back buttons, except on messages and questions
  if [ -n "${WT_NAV:-}" ] && [ "$box" != "--msgbox" ] && [ "$box" != "--yesno" ]; then
    nav=(--ok-button Next --cancel-button Back)
  fi
  whiptail --backtitle "$(printf '%-*s' "$cols" "$backtitle")" "${nav[@]}" "${args[@]}" 3>&1 1>&2 2>&3 || rc=$?
  # A msgbox has nothing to answer: ESC closes it like OK instead of failing under set -e
  [ "$box" == "--msgbox" ] && rc=0
  return "$rc"
}

# Creates the container on a Proxmox host, runs the app's update inside the container
start() {
  local build_func
  if command -v pveversion >/dev/null 2>&1; then
    wt --title "CREATE CONTAINER" --yesno "This will create a new ${APP} LXC. Proceed?" || exit-script
    build_func=$(curl -fsSL https://raw.githubusercontent.com/Salvialf/pve-scripts/main/lib/build.func) || {
      msg_error "Unable to download build.func"
      exit 1
    }
    source /dev/stdin <<< "$build_func"
    install_script
  else
    wt --title "UPDATE CONTAINER" --yesno "This will update the ${APP} LXC. Proceed?" || exit-script
    update_script
  fi
}
