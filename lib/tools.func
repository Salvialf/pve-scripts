# The container comes from CT_ID, else from a menu of the host's containers
tool_choose_ct() {
  local menu=() id status name
  CT_ID="${CT_ID:-}"
  if [ -z "$CT_ID" ]; then
    # pct list columns: VMID Status Lock Name, Lock often empty
    while read -r id status name; do
      menu+=("$id" "$name ($status)")
    done < <(pct list | awk 'NR > 1 {print $1, $2, $NF}' || true)
    if [ ${#menu[@]} -eq 0 ]; then
      msg_error "No container found on this host"
      exit 1
    fi
    CT_ID=$(wt --title "${TOOL_NAME^^}" --menu "Choose the container to give the $TOOL_NAME to" "${menu[@]}") || exit-script
  fi
  if [ ! -f "/etc/pve/lxc/${CT_ID}.conf" ]; then
    msg_error "Container $CT_ID not found"
    exit 1
  fi
}

# The container's passthrough devices, one "devN path" line each, without their options
tool_devices() {
  awk -F '[:,]' '/^dev[0-9]+:/ {sub(/^ *(path=)?/, "", $2); print $1, $2}' <<< "$(pct config "$CT_ID")"
}

# The devN passing the host's $1 through, empty when the container doesn't have it
tool_device_key() {
  tool_devices | awk -v path="$1" '$2 == path {print $1}'
}

# Stops when the container gets the device through lxc.* lines matching $1, a devN on top could stop it from starting
tool_lxc_lines() {
  local lines
  lines=$(grep -E "$1" <<< "$(pct config "$CT_ID")") || return 0
  msg_warn "Container $CT_ID gets the $TOOL_NAME through these lines of /etc/pve/lxc/$CT_ID.conf, remove them to use device passthrough instead:"
  echo "$lines"
  exit 0
}

# Proxmox's device passthrough on the first free devN, shown in the container's Resources
tool_add_device() {
  local index=0 config
  # With the changes waiting for a restart, so two devices added in a row don't share a devN
  config=$(pct config "$CT_ID")
  while grep -q "^dev$index:" <<< "$config"; do
    index=$((index + 1))
  done
  pct set "$CT_ID" "-dev$index" "$1"
}

# Passes each host device through with group $1, skipping the missing ones and those the container already has
tool_add_devices() {
  local gid="$1" path passed added=""
  shift
  passed=$(tool_devices | awk '{print $2}')
  for path in "$@"; do
    if [ ! -e "$path" ]; then
      msg_error "${path##*/} not found on this host, skipped"
      continue
    fi
    if grep -qxF "$path" <<< "$passed"; then
      msg_ok "Container $CT_ID already has ${path##*/}"
      continue
    fi
    tool_add_device "$path,gid=$gid"
    msg_ok "Gave ${path##*/} to container $CT_ID"
    added="yes"
  done
  if [ -n "$added" ]; then
    tool_offer_restart
  fi
}

# Asks only when pct pending still lists a device change: Proxmox VE 9 applies an added device at once, 8 waits for the restart
tool_offer_restart() {
  if grep -q running <<< "$(pct status "$CT_ID")" && grep -qE '^(new|del) dev[0-9]+:' <<< "$(pct pending "$CT_ID")"; then
    if wt --title "${TOOL_NAME^^}" --yesno "The change only applies after a restart.\nContainer $CT_ID is running, restart it now?"; then
      msg_info "Restarting container $CT_ID"
      pct reboot "$CT_ID"
      msg_ok "Restarted container $CT_ID"
    else
      msg_warn "Restart container $CT_ID to apply"
    fi
  fi
}
